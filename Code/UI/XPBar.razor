@using Sandbox
@using Sandbox.UI
@using System
@using System.Linq
@namespace Sandbox.UI
@inherits PanelComponent
@* Force recompile - Dec 11 2025 *@

<root>
	<div class="xp-bar-wrapper @(_isLayoutMode ? "layout-mode" : "")">
		<div class="xp-bar-container">
			<div class="xp-skill-name">Lv. @(_hasSkills ? _combatLevel.ToString() : "-")</div>
			<div class="xp-bar-bg" onmouseover="@(() => _isHovered = true)" onmouseout="@(() => _isHovered = false)">
				<div @ref="_xpBarRef" class="xp-bar-fill"></div>
				<div class="xp-bar-text">@_xpText</div>
			</div>
			@if ( !_isLayoutMode && _isHovered )
			{
				<div class="xp-tooltip">
					<div class="xp-tooltip-title">Calculator</div>
					<div class="xp-tooltip-row"><span class="k">Player</span><span class="v">@_playerName</span></div>
					<div class="xp-tooltip-split"></div>
					<div class="xp-tooltip-row"><span class="k">Attack</span><span class="v">@_att</span></div>
					<div class="xp-tooltip-row"><span class="k">Strength</span><span class="v">@_str</span></div>
					<div class="xp-tooltip-row"><span class="k">Ranged</span><span class="v">@_rng</span></div>
					<div class="xp-tooltip-row"><span class="k">Magic</span><span class="v">@_mag</span></div>
					<div class="xp-tooltip-row"><span class="k">Defence</span><span class="v">@_def</span></div>
					<div class="xp-tooltip-row"><span class="k">Hitpoints</span><span class="v">@_hp</span></div>
					<div class="xp-tooltip-row"><span class="k">Prayer</span><span class="v">@_pray</span></div>
					<div class="xp-tooltip-split"></div>
					<div class="xp-tooltip-row"><span class="k">Combat</span><span class="v">@_combatSummary</span></div>
					@if ( _nextReqLines != null && _nextReqLines.Count > 0 )
					{
						<div class="xp-tooltip-split"></div>
						<div class="xp-tooltip-title">For level @_nextCombatTarget</div>
						@foreach ( var line in _nextReqLines )
						{
							<div class="xp-tooltip-line">@line</div>
						}
					}
				</div>
			}
			@if ( !_isLayoutMode && !string.IsNullOrEmpty( _nextCombatHint ) )
			{
				<div class="xp-hint">@_nextCombatHint</div>
			}
		</div>
	</div>
</root>

@code
{
	Panel _xpBarRef;
	string _xpText = "0 / 0";
	int _combatLevel;
	float _combatPrecise;
	string _combatType = "Warrior";
	string _nextCombatHint = "";
	bool _hasSkills;
	bool _isLayoutMode;
	bool _isHovered;
	string _playerName = "";
	int _att, _str, _def, _rng, _mag, _hp, _pray;
	string _combatSummary = "";
	int _nextCombatTarget;
	System.Collections.Generic.List<string> _nextReqLines = new();

	protected override int BuildHash()
	{
		int h = HashCode.Combine( _hasSkills, _combatLevel, _combatPrecise, _xpText );
		h = HashCode.Combine( h, _combatType, _nextCombatHint, _isLayoutMode, _isHovered );
		return h;
	}

	// Instance wrappers to avoid static method substitution errors
	bool IsLayoutActive => VeggaHudLayoutState.IsActive;
	Vector2 GetLayoutPosition( string key, Vector2 def ) => VeggaHudLayoutState.GetPosition( key, def );
	float GetLayoutScale( string key, float def ) => VeggaHudLayoutState.GetScale( key, def );
	void SaveLayoutPosition( string key, Vector2 pos ) => VeggaHudLayoutState.SetPosition( key, pos );
	string XpBarKey => VeggaHudLayoutState.KeyXpBar;
	string SelectedElement => VeggaHudLayoutState.SelectedElement;

	protected override void OnUpdate()
	{
		_isLayoutMode = IsLayoutActive;

		// Update combat stats
		UpdateCombatStats();

		// Keep selected HUD visible above the editor without stealing clicks.
		if ( Panel != null )
		{
			bool isSelected = _isLayoutMode && SelectedElement == XpBarKey;
			Panel.Style.ZIndex = isSelected ? 2601 : 0;
			Panel.Style.PointerEvents = isSelected ? PointerEvents.None : PointerEvents.None;
		}
		ApplyPosition();
	}

	void UpdateCombatStats()
	{
		var skills = FindLocalSkills();
		_hasSkills = skills != null;
		if ( skills == null )
		{
			_xpText = "--";
			_nextCombatHint = "";
			_combatSummary = "";
			_nextReqLines?.Clear();
			return;
		}

		_playerName = skills.GameObject?.Name ?? "Player";
		_att = skills.AttackLevel;
		_str = skills.StrengthLevel;
		_def = skills.DefenceLevel;
		_rng = skills.RangedLevel;
		_mag = skills.MagicLevel;
		_hp = skills.HitpointsLevel;
		_pray = skills.PrayerLevel;

		_combatLevel = skills.CombatLevel;
		_combatPrecise = skills.CombatLevelPrecise;
		_combatType = skills.CombatType;
		_nextCombatHint = skills.NextCombatHint;
		_combatSummary = BuildCombatSummary( skills );
		BuildNextCombatRequirements( skills );

		// Fractional progress towards next combat level
		float frac = _combatPrecise - _combatLevel;
		frac = frac.Clamp( 0f, 0.999f );
		_xpText = $"{_combatPrecise:0.0} / {_combatLevel + 1}";

		// Update bar width
		if ( _xpBarRef != null )
		{
			float pct = frac * 100f;
			_xpBarRef.Style.Set( "width", $"{pct}%" );
		}
	}

	PlayerVeggaSkills FindLocalSkills()
	{
		// 1) Preferred: local stats cache (works on host / proper ownership setups)
		var stats = PlayerVeggaStats.Local;
		var skillsFromStats = stats?.Components.Get<PlayerVeggaSkills>();
		if ( skillsFromStats != null && skillsFromStats.IsValid() )
			return skillsFromStats;

		var scene = Game.ActiveScene;
		if ( scene == null )
			return null;

		// 2) Try exact network owner match
		var localConn = Connection.Local;
		if ( localConn != null )
		{
			foreach ( var skills in scene.GetAllComponents<PlayerVeggaSkills>() )
			{
				if ( skills == null || !skills.IsValid() )
					continue;

				var net = skills.Network;
				if ( net != null && net.Owner == localConn )
					return skills;
			}
		}

		// 3) Prefer a non-proxy instance if available
		foreach ( var skills in scene.GetAllComponents<PlayerVeggaSkills>() )
		{
			if ( skills == null || !skills.IsValid() )
				continue;

			var net = skills.Network;
			if ( net == null || !net.IsProxy )
				return skills;
		}

		// 4) Last resort: first valid
		return scene.GetAllComponents<PlayerVeggaSkills>().FirstOrDefault( s => s != null && s.IsValid() );
	}

	string BuildCombatSummary( PlayerVeggaSkills skills )
	{
		// Compute a slightly nicer description than the raw combat type.
		double melee = 0.325 * (skills.AttackLevel + skills.StrengthLevel);
		double range = 0.325 * Math.Floor( skills.RangedLevel * 1.5 );
		double mage = 0.325 * Math.Floor( skills.MagicLevel * 1.5 );
		double max = Math.Max( melee, Math.Max( range, mage ) );
		double second = melee + range + mage - max - Math.Min( melee, Math.Min( range, mage ) );
		bool balanced = Math.Abs( max - second ) < 0.25;
		return balanced ? $"{skills.CombatLevel} (balanced)" : $"{skills.CombatLevel} ({skills.CombatType})";
	}

	void BuildNextCombatRequirements( PlayerVeggaSkills skills )
	{
		_nextReqLines ??= new();
		_nextReqLines.Clear();

		int target = skills.CombatLevel + 1;
		_nextCombatTarget = target;

		int? dAtt = DeltaToNext( skills, SkillId.Attack );
		int? dStr = DeltaToNext( skills, SkillId.Strength );
		int? dHp = DeltaToNext( skills, SkillId.Hitpoints );
		int? dDef = DeltaToNext( skills, SkillId.Defence );
		int? dRng = DeltaToNext( skills, SkillId.Ranged );
		int? dMag = DeltaToNext( skills, SkillId.Magic );
		int? dPray = DeltaToNext( skills, SkillId.Prayer );

		AddMerged( dAtt, dStr, "Attack", "Strength" );
		AddMerged( dHp, dDef, "Hitpoints", "Defence" );
		AddSingle( dRng, "Ranged" );
		AddSingle( dMag, "Magic" );
		AddSingle( dPray, "Prayer" );
	}

	void AddSingle( int? delta, string label )
	{
		if ( delta == null ) return;
		_nextReqLines.Add( $"{delta} {label} level{(delta == 1 ? "" : "s")}" );
	}

	void AddMerged( int? a, int? b, string la, string lb )
	{
		if ( a == null && b == null ) return;
		if ( a != null && b != null && a.Value == b.Value )
		{
			_nextReqLines.Add( $"{a} {la} or {lb} level{(a == 1 ? "" : "s")}" );
			return;
		}
		AddSingle( a, la );
		AddSingle( b, lb );
	}

	int? DeltaToNext( PlayerVeggaSkills skills, SkillId skill )
	{
		int att = skills.AttackLevel;
		int str = skills.StrengthLevel;
		int def = skills.DefenceLevel;
		int hp = skills.HitpointsLevel;
		int pray = skills.PrayerLevel;
		int rng = skills.RangedLevel;
		int mag = skills.MagicLevel;

		double Calc( int a, int s, int d, int h, int p, int r, int m )
		{
			double basePart = 0.25 * (d + h + Math.Floor( p / 2.0 ));
			double melee = 0.325 * (a + s);
			double range = 0.325 * Math.Floor( r * 1.5 );
			double mage = 0.325 * Math.Floor( m * 1.5 );
			double style = Math.Max( melee, Math.Max( range, mage ) );
			return basePart + style;
		}

		int currentFloor = skills.CombatLevel;
		for ( int i = 1; i <= 20; i++ )
		{
			switch ( skill )
			{
				case SkillId.Attack: if ( Math.Floor( Calc( att + i, str, def, hp, pray, rng, mag ) ) > currentFloor ) return i; break;
				case SkillId.Strength: if ( Math.Floor( Calc( att, str + i, def, hp, pray, rng, mag ) ) > currentFloor ) return i; break;
				case SkillId.Defence: if ( Math.Floor( Calc( att, str, def + i, hp, pray, rng, mag ) ) > currentFloor ) return i; break;
				case SkillId.Hitpoints: if ( Math.Floor( Calc( att, str, def, hp + i, pray, rng, mag ) ) > currentFloor ) return i; break;
				case SkillId.Prayer: if ( Math.Floor( Calc( att, str, def, hp, pray + i, rng, mag ) ) > currentFloor ) return i; break;
				case SkillId.Ranged: if ( Math.Floor( Calc( att, str, def, hp, pray, rng + i, mag ) ) > currentFloor ) return i; break;
				case SkillId.Magic: if ( Math.Floor( Calc( att, str, def, hp, pray, rng, mag + i ) ) > currentFloor ) return i; break;
			}
		}

		return null;
	}

	void ApplyPosition()
	{
		if ( Panel == null ) return;
		VeggaHudLayoutApply.Apply( Panel, XpBarKey, VeggaHudLayoutState.GetDefaultPosition( XpBarKey ), 1f );
	}

	string FormatXP( int xp )
	{
		if ( xp >= 1000000 ) return $"{xp / 1000000f:F1}M";
		if ( xp >= 1000 ) return $"{xp / 1000f:F1}K";
		return xp.ToString();
	}
}

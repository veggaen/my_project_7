@using Sandbox
@using Sandbox.UI
@using System.Linq
@namespace Sandbox.UI
@inherits PanelComponent
@* Force recompile - Dec 11 2025 *@

<root>
	<div class="xp-bar-wrapper @(_isLayoutMode ? "layout-mode" : "") @(_isDragging ? "dragging" : "")">
		@if ( _isLayoutMode )
		{
			<div class="drag-handle" onmousedown="@OnDragStart">
				<span class="drag-icon">✥</span>
				<span class="drag-label">XP Bar</span>
			</div>
			<div class="nudge-controls">
				<button class="nudge-btn" onclick="@(() => Nudge(-0.01f, 0))">◀</button>
				<button class="nudge-btn" onclick="@(() => Nudge(0, -0.01f))">▲</button>
				<button class="nudge-btn" onclick="@(() => Nudge(0, 0.01f))">▼</button>
				<button class="nudge-btn" onclick="@(() => Nudge(0.01f, 0))">▶</button>
			</div>
		}
		<div class="xp-bar-container">
			<div class="xp-skill-name">Combat @_combatLevel (@_combatType)</div>
			<div class="xp-bar-bg">
				<div @ref="_xpBarRef" class="xp-bar-fill"></div>
				<div class="xp-bar-text">@_xpText</div>
			</div>
			@if ( !_isLayoutMode && !string.IsNullOrEmpty( _nextCombatHint ) )
			{
				<div class="xp-hint">@_nextCombatHint</div>
			}
		</div>
	</div>
</root>

@code
{
	Panel _xpBarRef;
	string _xpText = "0 / 0";
	int _combatLevel;
	float _combatPrecise;
	string _combatType = "Warrior";
	string _nextCombatHint = "";
	bool _isLayoutMode;

	// Drag state
	bool _isDragging;
	Vector2 _dragStartMouse;
	Vector2 _dragStartPos;

	// Layout position (normalized 0–1)
	Vector2 _layoutPos = new Vector2( 0.5f, 0.92f ); // Default: bottom center

	// Instance wrappers to avoid static method substitution errors
	bool IsLayoutActive => VeggaHudLayoutState.IsActive;
	Vector2 GetLayoutPosition( string key, Vector2 def ) => VeggaHudLayoutState.GetPosition( key, def );
	void SaveLayoutPosition( string key, Vector2 pos ) => VeggaHudLayoutState.SetPosition( key, pos );
	string XpBarKey => VeggaHudLayoutState.KeyXpBar;

	protected override void OnStart()
	{
		// Load saved position
		_layoutPos = GetLayoutPosition( XpBarKey, _layoutPos );
	}

	protected override void OnUpdate()
	{
		_isLayoutMode = IsLayoutActive;

		// Handle dragging
		if ( _isDragging )
		{
			UpdateDrag();
		}

		// Update combat stats
		UpdateCombatStats();

		// Apply position to panel
		ApplyPosition();
	}

	void UpdateCombatStats()
	{
		var player = PlayerVeggaStats.Local;
		if ( player == null ) return;

		var skills = player.GameObject.Components.Get<PlayerVeggaSkills>();
		if ( skills == null ) return;

		_combatLevel = skills.CombatLevel;
		_combatPrecise = skills.CombatLevelPrecise;
		_combatType = skills.CombatType;
		_nextCombatHint = skills.NextCombatHint;

		// Fractional progress towards next combat level
		float frac = _combatPrecise - _combatLevel;
		frac = frac.Clamp( 0f, 0.999f );
		_xpText = $"{_combatPrecise:0.0} / {_combatLevel + 1}";

		// Update bar width
		if ( _xpBarRef != null )
		{
			float pct = frac * 100f;
			_xpBarRef.Style.Set( "width", $"{pct}%" );
		}
	}

	void ApplyPosition()
	{
		if ( Panel == null ) return;

		var screenSize = Screen.Size;
		if ( screenSize.x <= 0 || screenSize.y <= 0 ) return;

		// Convert normalized position to pixels
		// Offset by half the element size to center it on the position
		float pxX = _layoutPos.x * screenSize.x;
		float pxY = _layoutPos.y * screenSize.y;

		Panel.Style.Position = PositionMode.Absolute;
		Panel.Style.Left = Length.Pixels( pxX - 150 ); // Center horizontally (bar is ~300px wide)
		Panel.Style.Top = Length.Pixels( pxY );
	}

	void OnDragStart()
	{
		if ( !_isLayoutMode ) return;

		_isDragging = true;
		_dragStartMouse = Mouse.Position;
		_dragStartPos = _layoutPos;

		Log.Info( $"[XPBar] Drag started at {_dragStartMouse}" );
	}

	void UpdateDrag()
	{
		// Stop dragging if mouse released
		if ( !Input.Down( "attack1" ) )
		{
			StopDrag();
			return;
		}

		var screenSize = Screen.Size;
		if ( screenSize.x <= 0 || screenSize.y <= 0 ) return;

		// Calculate delta in normalized coords
		var currentMouse = Mouse.Position;
		var deltaPixels = currentMouse - _dragStartMouse;
		var deltaNorm = new Vector2(
			deltaPixels.x / screenSize.x,
			deltaPixels.y / screenSize.y
		);

		// Apply delta to starting position
		_layoutPos = _dragStartPos + deltaNorm;

		// Clamp to screen bounds
		_layoutPos.x = _layoutPos.x.Clamp( 0.1f, 0.9f );
		_layoutPos.y = _layoutPos.y.Clamp( 0.05f, 0.95f );
	}

	void StopDrag()
	{
		if ( !_isDragging ) return;

		_isDragging = false;

		// Save the new position
		SaveLayoutPosition( XpBarKey, _layoutPos );
		Log.Info( $"[XPBar] Saved position: {_layoutPos}" );
	}

	void Nudge( float dx, float dy )
	{
		_layoutPos.x = (_layoutPos.x + dx).Clamp( 0.1f, 0.9f );
		_layoutPos.y = (_layoutPos.y + dy).Clamp( 0.05f, 0.95f );

		// Save immediately
		SaveLayoutPosition( XpBarKey, _layoutPos );
		Log.Info( $"[XPBar] Nudged to: {_layoutPos}" );
	}

	string FormatXP( int xp )
	{
		if ( xp >= 1000000 ) return $"{xp / 1000000f:F1}M";
		if ( xp >= 1000 ) return $"{xp / 1000f:F1}K";
		return xp.ToString();
	}
}

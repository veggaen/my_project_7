@using Sandbox
@using Sandbox.UI
@using System
@namespace Sandbox.UI
@inherits PanelComponent
@attribute [StyleSheet( "/code/ui/combat/ammohud.razor.scss" )]

<root>
	@if ( _visible )
	{
		<div class="ammo-root @(_dual ? "dual" : "single")">
			<div class="ammo-top">
				<span class="ammo-label">@(_dual ? "DUAL 9MM" : "AMMO")</span>
				<span class="ammo-reserve">RES @_reserve</span>
			</div>
			@if ( _dual )
			{
				<div class="ammo-dual-grid">
					<div class="ammo-column left">
						<div class="ammo-column-top">
							<span class="ammo-side">L</span>
							<span class="ammo-mag">@_leftMag / @_cap</span>
						</div>
						<div class="ammo-bar">
							<div @ref="_leftFillRef" class="ammo-fill"></div>
						</div>
					</div>
					<div class="ammo-column right">
						<div class="ammo-column-top">
							<span class="ammo-side">R</span>
							<span class="ammo-mag">@_rightMag / @_cap</span>
						</div>
						<div class="ammo-bar">
							<div @ref="_rightFillRef" class="ammo-fill"></div>
						</div>
					</div>
				</div>
			}
			else
			{
				<div class="ammo-row">
					<div class="ammo-bar">
						<div @ref="_fillRef" class="ammo-fill"></div>
					</div>
					<div class="ammo-mag">@_mag / @_cap</div>
				</div>
			}
		</div>
	}
</root>

@code
{
	global::Sandbox.VeggaInventory _inventory;
	global::Sandbox.VeggaEquipmentController _equipment;
	Panel _fillRef;
	Panel _leftFillRef;
	Panel _rightFillRef;
	bool _registered;

	bool _visible;
	bool _dual;
	int _mag;
	int _cap;
	int _reserve;
	int _leftMag;
	int _rightMag;
	float _magPct;
	float _leftPct;
	float _rightPct;

	private static global::Sandbox.VeggaEquipmentController FindLocalEquipmentController()
	{
		var local = Connection.Local;
		if ( local == null )
			return null;

		var stats = global::Sandbox.PlayerVeggaStats.Local;
		var go = stats?.GameObject;
		if ( go != null && go.IsValid() )
		{
			var eq = go.Components.Get<global::Sandbox.VeggaEquipmentController>( FindMode.InSelf | FindMode.InDescendants );
			if ( eq != null && eq.IsValid() )
				return eq;
		}

		var scene = Game.ActiveScene;
		if ( scene == null )
			return null;

		foreach ( var eq in scene.GetAllComponents<global::Sandbox.VeggaEquipmentController>() )
		{
			if ( eq == null || !eq.IsValid() )
				continue;
			if ( eq.Network?.IsProxy == true )
				continue;
			if ( eq.GameObject?.Network?.Owner == local )
				return eq;
		}

		return null;
	}

	protected override void OnUpdate()
	{
		if ( Connection.Local == null )
			return;

		const string AmmoKey = "ammo_counter";

		if ( !_registered )
		{
			_registered = true;
			VeggaHudLayoutState.RegisterElement(
				AmmoKey,
				"Ammo",
				VeggaHudLayoutState.GetDefaultPosition( AmmoKey )
			);
		}

		if ( Panel != null )
		{
			VeggaHudLayoutApply.Apply( Panel, AmmoKey, VeggaHudLayoutState.GetDefaultPosition( AmmoKey ), 1f );
			Panel.Style.PointerEvents = PointerEvents.None;
			Panel.Style.ZIndex = VeggaHudLayoutState.IsActive && VeggaHudLayoutState.SelectedElement == AmmoKey ? 2601 : 0;
		}

		var invOwner = _inventory?.GameObject?.Network?.Owner;
		if ( _inventory == null || !_inventory.IsValid() || invOwner != Connection.Local || _inventory.Network?.IsProxy == true )
			_inventory = VeggaInventory.Local;

		if ( _equipment == null || !_equipment.IsValid() )
			_equipment = FindLocalEquipmentController();

		_visible = false;
		_dual = false;
		_mag = 0;
		_cap = 0;
		_reserve = 0;
		_leftMag = 0;
		_rightMag = 0;
		_magPct = 0f;
		_leftPct = 0f;
		_rightPct = 0f;

		if ( _inventory == null || !_inventory.IsValid() || _equipment == null || !_equipment.IsValid() )
			return;

		var slot = _equipment.ActiveHotbarSlot;
		if ( slot < 0 || slot > 8 )
			return;

		if ( !_equipment.TryGetAmmoDisplay( out var dualWield, out var leftMag, out var rightMag, out var cap, out var reserve ) )
			return;

		_visible = true;
		_dual = dualWield;
		_cap = Math.Max( 0, cap );
		_leftMag = Math.Max( 0, leftMag );
		_rightMag = Math.Max( 0, rightMag );
		_reserve = Math.Max( 0, reserve );
		_mag = _rightMag;
		_magPct = _cap > 0 ? (_mag / (float)_cap) * 100f : 0f;
		_magPct = _magPct.Clamp( 0f, 100f );
		_leftPct = _cap > 0 ? (_leftMag / (float)_cap) * 100f : 0f;
		_rightPct = _cap > 0 ? (_rightMag / (float)_cap) * 100f : 0f;
		_leftPct = _leftPct.Clamp( 0f, 100f );
		_rightPct = _rightPct.Clamp( 0f, 100f );

		_fillRef?.Style.Set( "width", $"{_magPct}%" );
		_leftFillRef?.Style.Set( "width", $"{_leftPct}%" );
		_rightFillRef?.Style.Set( "width", $"{_rightPct}%" );
	}

	protected override int BuildHash()
	{
		return HashCode.Combine( _visible, _dual, _mag, _leftMag, _rightMag, _cap, _reserve, _inventory?.Revision ?? 0, _equipment?.ActiveHotbarSlot ?? -1 );
	}
}

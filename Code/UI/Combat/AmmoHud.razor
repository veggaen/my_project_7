@using Sandbox
@using Sandbox.UI
@using System
@namespace Sandbox.UI
@inherits PanelComponent
@attribute [StyleSheet( "/code/ui/combat/ammohud.razor.scss" )]

<root>
	@if ( _visible )
	{
		<div class="ammo-root @(_dual ? "dual" : "single")">
			<div class="ammo-top">
				<div class="ammo-title-block">
					<span class="ammo-label">COMBAT</span>
					<span class="ammo-weapon">@_weaponLabel</span>
				</div>
				<div class="ammo-meta-block">
					<span class="ammo-mode @(_ads ? "ads" : "")">@_modeLabel</span>
					<span class="ammo-reserve">RES @_reserve</span>
				</div>
			</div>
			@if ( _dual )
			{
				<div class="ammo-dual-grid">
					<div class="ammo-column left">
						<div class="ammo-column-top">
							<span class="ammo-side">L</span>
							<span class="ammo-mag">@_leftMag / @_cap</span>
						</div>
						<div class="ammo-bar">
							<div @ref="_leftFillRef" class="ammo-fill"></div>
						</div>
					</div>
					<div class="ammo-column right">
						<div class="ammo-column-top">
							<span class="ammo-side">R</span>
							<span class="ammo-mag">@_rightMag / @_cap</span>
						</div>
						<div class="ammo-bar">
							<div @ref="_rightFillRef" class="ammo-fill"></div>
						</div>
					</div>
				</div>
			}
			else
			{
				<div class="ammo-row">
					<div class="ammo-bar">
						<div @ref="_fillRef" class="ammo-fill"></div>
					</div>
					<div class="ammo-mag">@_mag / @_cap</div>
				</div>
			}
			<div class="ammo-footer">
				<span class="ammo-hint">@_footerHint</span>
			</div>
		</div>
	}
</root>

@code
{
	global::Sandbox.VeggaInventory _inventory;
	global::Sandbox.VeggaEquipmentController _equipment;
	Panel _fillRef;
	Panel _leftFillRef;
	Panel _rightFillRef;
	bool _registered;

	bool _visible;
	bool _dual;
	bool _ads;
	int _mag;
	int _cap;
	int _reserve;
	int _leftMag;
	int _rightMag;
	string _weaponLabel = string.Empty;
	string _modeLabel = string.Empty;
	string _footerHint = string.Empty;
	float _magPct;
	float _leftPct;
	float _rightPct;

	private bool IsLocalAimRequested()
	{
		var equipment = FindLocalEquipmentController();
		if ( equipment == null || !equipment.IsValid() )
			return false;
		if ( VeggaUiMouse.WantsUiMouse )
			return false;
		if ( equipment.HoldType == VeggaHoldType.None )
			return false;
		if ( !equipment.CanAim() )
			return false;

		return Input.Down( "Attack2" ) || Input.Down( "attack2" );
	}

	private static global::Sandbox.VeggaEquipmentController FindLocalEquipmentController()
	{
		return global::Sandbox.VeggaEquipmentController.Local;
	}

	protected override void OnUpdate()
	{
		if ( Connection.Local == null )
			return;

		const string AmmoKey = "ammo_counter";

		if ( !_registered )
		{
			_registered = true;
			VeggaHudLayoutState.RegisterElement(
				AmmoKey,
				"Ammo",
				VeggaHudLayoutState.GetDefaultPosition( AmmoKey )
			);
		}

		if ( Panel != null )
		{
			VeggaHudLayoutApply.Apply( Panel, AmmoKey, VeggaHudLayoutState.GetDefaultPosition( AmmoKey ), 1f );
			Panel.Style.PointerEvents = PointerEvents.None;
			Panel.Style.ZIndex = VeggaHudLayoutState.IsActive && VeggaHudLayoutState.SelectedElement == AmmoKey ? 2601 : 0;
		}

		var invOwner = _inventory?.GameObject?.Network?.Owner;
		if ( _inventory == null || !_inventory.IsValid() || invOwner != Connection.Local || _inventory.Network?.IsProxy == true )
			_inventory = VeggaInventory.Local;

		var equipment = FindLocalEquipmentController();
		_equipment = equipment;

		_visible = false;
		_dual = false;
		_ads = false;
		_mag = 0;
		_cap = 0;
		_reserve = 0;
		_leftMag = 0;
		_rightMag = 0;
		_weaponLabel = string.Empty;
		_modeLabel = string.Empty;
		_footerHint = string.Empty;
		_magPct = 0f;
		_leftPct = 0f;
		_rightPct = 0f;

		if ( _inventory == null || !_inventory.IsValid() || equipment == null || !equipment.IsValid() )
			return;

		if ( equipment.HoldType == VeggaHoldType.None )
			return;

		var slot = equipment.ActiveHotbarSlot;
		if ( slot < 0 || slot > 8 )
			return;

		if ( !equipment.TryGetAmmoDisplay( out var dualWield, out var leftMag, out var rightMag, out var cap, out var reserve ) )
			return;

		_visible = true;
		_dual = dualWield;
		_ads = equipment.IsAiming || IsLocalAimRequested();
		_cap = Math.Max( 0, cap );
		_leftMag = Math.Max( 0, leftMag );
		_rightMag = Math.Max( 0, rightMag );
		_reserve = Math.Max( 0, reserve );
		_mag = _rightMag;
		if ( equipment.TryGetActiveWeaponSpec( out var spec ) )
		{
			var def = VeggaItemRegistry.Get( spec.ItemId );
			_weaponLabel = def?.Name ?? (_dual ? "Dual Pistols" : "Weapon");
			_modeLabel = _dual ? "DUAL" : (_ads ? "ADS" : "HIP");
			if ( spec.IsDualWield )
			{
				_footerHint = equipment.LastFireSide < 0 ? "LEAD LEFT  |  M1 CAMERA SIDE  |  M2 OFF SIDE" : "LEAD RIGHT  |  M1 CAMERA SIDE  |  M2 OFF SIDE";
			}
			else
			{
				_footerHint = spec.SupportsAds ? (_ads ? "ADS STABLE  |  MOVE SLOWED" : "RMB TO AIM  |  ADS AVAILABLE") : "HIP FIRE ONLY";
			}
		}
		_magPct = _cap > 0 ? (_mag / (float)_cap) * 100f : 0f;
		_magPct = _magPct.Clamp( 0f, 100f );
		_leftPct = _cap > 0 ? (_leftMag / (float)_cap) * 100f : 0f;
		_rightPct = _cap > 0 ? (_rightMag / (float)_cap) * 100f : 0f;
		_leftPct = _leftPct.Clamp( 0f, 100f );
		_rightPct = _rightPct.Clamp( 0f, 100f );

		_fillRef?.Style.Set( "width", $"{_magPct}%" );
		_leftFillRef?.Style.Set( "width", $"{_leftPct}%" );
		_rightFillRef?.Style.Set( "width", $"{_rightPct}%" );
	}

	protected override int BuildHash()
	{
		var equipment = FindLocalEquipmentController();
		var localAimRequested = IsLocalAimRequested();
		return HashCode.Combine(
			HashCode.Combine( _visible, _dual, _mag, _leftMag ),
			HashCode.Combine( _rightMag, _cap, _reserve, _inventory?.Revision ?? 0 ),
			HashCode.Combine( equipment?.ActiveHotbarSlot ?? -1, (equipment?.IsAiming ?? false) || localAimRequested, equipment?.HoldType ?? VeggaHoldType.None, equipment?.GetEquippedItemId() ?? 0 )
		);
	}
}

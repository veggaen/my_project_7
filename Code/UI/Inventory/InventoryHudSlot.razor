	protected override void OnAfterTreeRender( bool firstTime )
	{
		base.OnAfterTreeRender( firstTime );

		// IMPORTANT: drag events + IsInside() operate on this Panel instance.
		// Apply the slot styling classes to THIS panel (not the inner <root>).
		SetClass( "inventory-slot", true );
		SetClass( "has-item", HasItem );
		SetClass( "selected", HasItem && IsSelected );

		UpdateIconVisual();
	}

	void UpdateIconVisual()
	{
		if ( !_iconPanel.IsValid() || !_countPanel.IsValid() )
			return;

		// Always drive visuals from Tick (do not rely on Razor re-render) to avoid ghosting.
		_countPanel.Style.Set( "display", "none" );
		_countPanel.Text = "";

		bool hasUrl = !string.IsNullOrWhiteSpace( CssIconUrl );
		_hasRenderedThumb = false;

		// Empty slot: ensure any previous runtime thumbnail is cleared.
		if ( !HasItem )
		{
			_iconPanel.Style.Set( "background-image", "none" );
			ClearIconMaskTint( _iconPanel );
			ApplyIconTint( _iconPanel, 0 );
			_iconPanel.Style.Dirty();
			_iconPanel.Text = "";
			_iconPanel.SetClass( "rendered-thumb", false );
			_iconPanel.SetClass( "currency", false );
			_lastVisualKey = null;
			return;
		}

		// Count overlay (all stackables).
		if ( ItemCount > 1 )
		{
			_countPanel.Text = VeggaCurrency.FormatCompact( ItemCount );
			_countPanel.Style.Set( "display", "flex" );
		}

		// If we have an explicit icon URL, prefer it (SVGs, etc). Works for both stack and non-stack.
		if ( hasUrl )
		{
			// Drive icon URL directly (we no longer use inline Razor style for this).
			if ( IsNoted )
			{
				ApplyNotedMaskTint( _iconPanel, CssIconUrl );
			}
			else
			{
				ClearIconMaskTint( _iconPanel );
				_iconPanel.Style.Set( "background-image", $"url('{CssIconUrl}')" );
				_iconPanel.Style.Set( "background-size", "contain" );
				_iconPanel.Style.Set( "background-repeat", "no-repeat" );
				_iconPanel.Style.Set( "background-position", "center" );
				ApplyIconTint( _iconPanel, ItemId );
			}
			_iconPanel.Style.Dirty();
			_iconPanel.Text = "";
			_iconPanel.SetClass( "rendered-thumb", false );
			_iconPanel.SetClass( "currency", IsCash );
			_lastVisualKey = null;
			return;
		}

		// Ensure we don't keep a noted-item mask around when switching to thumbnails.
		ClearIconMaskTint( _iconPanel );

		var modelPath = ModelPath;
		var key = string.IsNullOrWhiteSpace( modelPath ) ? "no-model" : $"model:{modelPath}";
		if ( key == _lastVisualKey )
			return;

		_lastVisualKey = key;

		var tex = VeggaItemThumbnailCache.GetOrCreateModelThumbnail( modelPath );
		if ( tex is null )
		{
			_iconPanel.Style.Set( "background-image", "none" );
			ClearIconMaskTint( _iconPanel );
			ApplyIconTint( _iconPanel, 0 );
			_iconPanel.Style.Dirty();
			_iconPanel.SetClass( "rendered-thumb", false );
			_iconPanel.SetClass( "currency", IsCash );
			_iconPanel.Text = IconText;
			return;
		}

		_iconPanel.Style.SetBackgroundImage( tex );
		ApplyIconTint( _iconPanel, ItemId );
		_iconPanel.Style.Dirty();
		_iconPanel.SetClass( "rendered-thumb", true );
		_iconPanel.SetClass( "currency", false );
		_iconPanel.Text = "";
		_hasRenderedThumb = true;
	}


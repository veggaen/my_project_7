	protected override void OnMouseOver( MousePanelEvent e )
	{
		base.OnMouseOver( e );
		HoveredSlotIndex = SlotIndex;
		HoveredInventory = Inventory;
	}

	protected override void OnMouseOut( MousePanelEvent e )
	{
		base.OnMouseOut( e );
		if ( HoveredSlotIndex == SlotIndex && HoveredInventory == Inventory )
		{
			HoveredSlotIndex = -1;
			HoveredInventory = null;
		}
	}

	protected override void OnClick( MousePanelEvent e )
	{
		base.OnClick( e );

		// s&box can invoke OnClick for non-left buttons.
		// If we treat every click as LMB, RMB dragging/pickup will also toggle selection/details.
		var btn = GetMouseButtonKind( e );
		if ( btn != MouseButtonKind.Left )
			return;
		var dt = Time.Now - _lastManualDragEndAt;
		if ( _lastManualDragEndButton == MouseButtonKind.Left && dt >= 0f && dt < 0.2f )
			return;

		var inv = Inventory;
		if ( inv == null || !inv.IsValid() || inv.Network?.IsProxy == true || inv.Network?.Owner != Connection.Local )
			inv = global::Sandbox.VeggaInventory.Local;
		if ( inv == null || !inv.IsValid() )
			return;

		bool shiftDown = Input.Down( "Run" ) || Input.Down( "run" );
		bool ctrlDown = false;
		HandleSlotClick( inv, SlotIndex, MouseButtonKind.Left, shiftDown, ctrlDown );
	}

	protected override void OnRightClick( MousePanelEvent e )
	{
		base.OnRightClick( e );
		var dt = Time.Now - _lastManualDragEndAt;
		if ( _lastManualDragEndButton == MouseButtonKind.Right && dt >= 0f && dt < 0.2f )
			return;

		// If a manual RMB drag is active anywhere, consume this release to finalize the drag.
		if ( _manualRightOwner != null && _manualRightOwner.IsValid() && _manualRightOwner._manualRightDragging )
		{
			_manualRightOwner.EndManualRightDrag();
			return;
		}
		// If we armed RMB on this slot but didn't drag, clear arm state and treat as a normal click.
		if ( _manualRightOwner == this )
		{
			_manualRightOwner = null;
			_manualRightArmed = false;
			_manualRightDragging = false;
		}

		var inv = Inventory;
		if ( inv == null || !inv.IsValid() || inv.Network?.IsProxy == true || inv.Network?.Owner != Connection.Local )
			inv = global::Sandbox.VeggaInventory.Local;
		if ( inv == null || !inv.IsValid() )
			return;

		bool shiftDown = Input.Down( "Run" ) || Input.Down( "run" );
		bool ctrlDown = false;
		if ( DebugInput ) Log.Info( $"[InvUI] OnRightClick slot={SlotIndex} shift={shiftDown} hasItem={HasItem} hasHeld={HasHeld}" );
		HandleSlotClick( inv, SlotIndex, MouseButtonKind.Right, shiftDown, ctrlDown );
	}

	protected override void OnMiddleClick( MousePanelEvent e )
	{
		base.OnMiddleClick( e );
		var dt = Time.Now - _lastManualDragEndAt;
		if ( _lastManualDragEndButton == MouseButtonKind.Middle && dt >= 0f && dt < 0.2f )
			return;

		// If a manual MMB drag is active anywhere, consume this release to finalize the drag.
		if ( _manualSplitOwner != null && _manualSplitOwner.IsValid() && _manualSplitOwner._manualSplitDragging )
		{
			_manualSplitOwner.EndManualSplitDrag();
			return;
		}
		// If we armed MMB on this slot but didn't drag, clear arm state and treat as a normal click.
		if ( _manualSplitOwner == this )
		{
			_manualSplitOwner = null;
			_manualSplitArmed = false;
			_manualSplitDragging = false;
		}

		var inv = Inventory;
		if ( inv == null || !inv.IsValid() || inv.Network?.IsProxy == true || inv.Network?.Owner != Connection.Local )
			inv = global::Sandbox.VeggaInventory.Local;
		if ( inv == null || !inv.IsValid() )
			return;

		bool shiftDown = Input.Down( "Run" ) || Input.Down( "run" );
		bool ctrlDown = false;
		if ( DebugInput ) Log.Info( $"[InvUI] OnMiddleClick slot={SlotIndex} shift={shiftDown} hasItem={HasItem} hasHeld={HasHeld}" );
		HandleSlotClick( inv, SlotIndex, MouseButtonKind.Middle, shiftDown, ctrlDown );
	}

	protected override void OnMouseDown( MousePanelEvent e )
	{
		base.OnMouseDown( e );

		// IMPORTANT UX:
		// We do NOT perform pickup/place on mouse-down anymore.
		// s&box fires OnDragStart after mouse-down+move; if we mutate state here (HeldStack),
		// dragging becomes impossible and the details panel flickers while attempting to drag.
		var btn = GetMouseButtonKind( e );
		// NOTE: Avoid using Input actions to reinterpret mouse buttons.
		// In some setups while UI is open, Attack1/Attack2/InventorySplit report false even when
		// the mouse is pressed, which causes LMB clicks to be misclassified as RMB/MMB.
		bool attack1Down = Input.Down( "Attack1" ) || Input.Down( "attack1" );
		bool attack2Down = Input.Down( "Attack2" ) || Input.Down( "attack2" );
		bool splitDown = Input.Down( "InventorySplit" ) || Input.Down( "inventorysplit" );
		bool attack2Pressed = Input.Pressed( "Attack2" ) || Input.Pressed( "attack2" );
		bool splitPressed = Input.Pressed( "InventorySplit" ) || Input.Pressed( "inventorysplit" );
		if ( DebugInput && btn == MouseButtonKind.Other )
		{
			try
			{
				Log.Info( $"[InvUI] Unmapped mouse button raw='{e.Button}' int={Convert.ToInt32( e.Button )}" );
			}
			catch
			{
				Log.Info( $"[InvUI] Unmapped mouse button raw='{e.Button}'" );
			}
		}
		var shiftDown = Input.Down( "Run" ) || Input.Down( "run" );
		var ctrlDown = false;

		if ( DebugInput )
		{
			string rawBtn = "";
			string rawInt = "";
			try { rawBtn = (e?.Button?.ToString() ?? "").Trim(); } catch { rawBtn = ""; }
			try { rawInt = Convert.ToInt32( e?.Button ).ToString(); } catch { rawInt = ""; }
			Log.Info( $"[InvUI] MouseDown slot={SlotIndex} btn={btn} raw='{rawBtn}' rawInt={rawInt} shift={shiftDown} ctrl={ctrlDown} a1={attack1Down} a2={attack2Down}/{attack2Pressed} split={splitDown}/{splitPressed} hasItem={HasItem} item={SlotItemId}x{SlotItemCount}" );
		}

		// Arm manual split-drag from MMB down (works even when Input actions report false).
		if ( btn == MouseButtonKind.Middle && HasItem && !_manualSplitDragging )
		{
			_manualSplitOwner = this;
			_manualSplitArmed = true;
			_manualSplitDragging = false;
			_manualSplitStartScreen = Mouse.Position;
			_manualSplitShift = shiftDown;
			_manualSplitCount = 1;

			int available = SlotItemCount;
			int itemId = SlotItemId;
			if ( itemId > 0 && available > 1 )
			{
				var def = VeggaItemRegistry.Get( itemId );
				int maxStack = VeggaInventory.GetEffectiveMaxStackForItem( itemId, def );
				if ( available > maxStack )
					available = maxStack;
				if ( maxStack > 1 )
				{
					// Use long math to avoid overflow when available is very large (e.g., int.MaxValue currency stacks).
					long avail = available;
					long want = _manualSplitShift ? (avail + 2L) / 3L : (avail + 1L) / 2L;
					want = Math.Clamp( want, 1L, avail );
					_manualSplitCount = (int)want;
				}
			}

			if ( DebugInput ) Log.Info( $"[InvUI] ManualSplit armed slot={SlotIndex} count={_manualSplitCount} shift={_manualSplitShift}" );

		}

		// Arm manual right-drag (Rust-like move-1 dragging).
		if ( btn == MouseButtonKind.Right && HasItem && !_manualRightDragging )
		{
			_manualRightOwner = this;
			_manualRightArmed = true;
			_manualRightDragging = false;
			_manualRightStartScreen = Mouse.Position;
		}

		// Arm manual left-drag (move/swap full stack).
		// Only when not using the held-stack model.
		if ( btn == MouseButtonKind.Left && HasItem && !_manualLeftDragging && !HasHeld )
		{
			_manualLeftOwner = this;
			_manualLeftArmed = true;
			_manualLeftDragging = false;
			_manualLeftStartScreen = Mouse.Position;
		}

		// Click behavior is handled in OnClick/OnRightClick/OnMiddleClick.
		// InventorySplit manual drag is armed in TickManualSplitDrag().
	}

	protected override void OnMouseUp( MousePanelEvent e )
	{
		try { base.OnMouseUp( e ); }
		catch ( EntryPointNotFoundException ) { }

		// End manual drags on mouse-up regardless of the reported button.
		// Some setups misreport button-up, which previously left the manual drag active
		// and allowed other handlers to run, resulting in full-stack moves.
		if ( _manualSplitOwner != null && _manualSplitOwner.IsValid() && _manualSplitOwner._manualSplitDragging )
			_manualSplitOwner.EndManualSplitDrag();
		if ( _manualRightOwner != null && _manualRightOwner.IsValid() && _manualRightOwner._manualRightDragging )
			_manualRightOwner.EndManualRightDrag();
		if ( _manualLeftOwner != null && _manualLeftOwner.IsValid() && _manualLeftOwner._manualLeftDragging )
			_manualLeftOwner.EndManualLeftDrag();

		// If any manual drag was armed but never dragged, clear it.
		// MouseUp can be delivered to a different panel than MouseDown, so this must be global.
		if ( _manualSplitOwner != null && _manualSplitOwner.IsValid() && _manualSplitOwner._manualSplitArmed && !_manualSplitOwner._manualSplitDragging )
		{
			_manualSplitOwner._manualSplitArmed = false;
			_manualSplitOwner._manualSplitDragging = false;
			_manualSplitOwner = null;
		}
		if ( _manualRightOwner != null && _manualRightOwner.IsValid() && _manualRightOwner._manualRightArmed && !_manualRightOwner._manualRightDragging )
		{
			_manualRightOwner._manualRightArmed = false;
			_manualRightOwner._manualRightDragging = false;
			_manualRightOwner = null;
		}
		if ( _manualLeftOwner != null && _manualLeftOwner.IsValid() && _manualLeftOwner._manualLeftArmed && !_manualLeftOwner._manualLeftDragging )
		{
			_manualLeftOwner._manualLeftArmed = false;
			_manualLeftOwner._manualLeftDragging = false;
			_manualLeftOwner = null;
		}

		// Always clear the drag-capture overlay on mouse-up.
		ClearDragCaptureOverlay();
	}

	void HandleSlotClick( global::Sandbox.VeggaInventory inv, int slotIndex, MouseButtonKind button, bool shiftDown, bool ctrlDown )
	{

		// Ctrl-transfer requires a second inventory (container) which isn't wired up yet.
		if ( ctrlDown )
			return;

		// Shift+click should not do special inventory actions (Rust-like).
		// We keep shift reserved for mouse3 half/third behavior and shift+RMB send-to-hotbar.

		// Shift+RMB: quick-move between main inventory and hotbar.
		if ( button == MouseButtonKind.Right && shiftDown && HasSlotItem )
		{
			// If a world container UI is open (furnace/storage), Shift+RMB quick-transfers into it.
			if ( WorldContainerUiContext.IsActive )
			{
				int count = Math.Max( 1, SlotItemCount );
				if ( WorldContainerUiContext.TryDepositFromPlayerInventory( inv, SlotIndex, count ) )
					return;
			}

			bool moved = SlotIndex >= 0 && SlotIndex < 9 ? TrySendToMainInventory( inv ) : TrySendToHotbar( inv );
			if ( moved )
			{
				return;
			}

			// Give feedback when shift+RMB does nothing.
			var def = VeggaItemRegistry.Get( SlotItemId );
			string name = def?.Name ?? $"Item {SlotItemId}";
			bool isDisallowed = def != null && def.Category is not ItemCategory.Consumable and not ItemCategory.Equipment;
			if ( !isDisallowed )
				VeggaChatManager.Local?.AddLocalMessage( $"Can't move {name} to action bar (no valid slot).", ChatMessageType.Error );
			if ( DebugInput ) Log.Info( $"[InvUI] Shift+RMB failed slot={SlotIndex} item={SlotItemId}x{SlotItemCount}" );
		}

		// If we're holding something, clicking a slot attempts to place it.
		if ( HasHeld && inv == _heldInventory )
		{
			if ( slotIndex == _heldSourceSlotIndex )
			{
				ClearHeld();
				return;
			}
			TryPlaceHeld( inv, slotIndex, button );
			return;
		}

		if ( !HasSlotItem )
		{
			// Clicking empty space should hide details.
			if ( button == MouseButtonKind.Left )
				OnSelected?.Invoke( -1 );
			return;
		}

		int itemId = SlotItemId;
		int available = SlotItemCount;
		if ( itemId <= 0 || available <= 0 )
			return;

		// Left-click is selection/details (NOT pickup). Drag handles moving.
		// Double-left-click: fill this stack toward max by pulling from other matching stacks.
		if ( button == MouseButtonKind.Left )
		{
			bool isDouble = _lastClickInventory == inv
				&& _lastClickSlotIndex == slotIndex
				&& _lastClickItemId == itemId
				&& _lastClickTime < 0.25f;

			_lastClickInventory = inv;
			_lastClickSlotIndex = slotIndex;
			_lastClickItemId = itemId;
			_lastClickTime = 0;

			if ( isDouble )
			{
				FillSlotToMaxFromOtherStacks( inv, slotIndex );
				available = inv.GetSlotCount( slotIndex );
			}

			OnSelected?.Invoke( slotIndex );
			return;
		}

		// RMB/MMB use the held-stack pickup model for moving/splitting.
		int takeCount = available;
		if ( button == MouseButtonKind.Right )		// pickup 1
			takeCount = 1;
		else if ( button == MouseButtonKind.Middle )	// pickup half / third
			takeCount = shiftDown ? Math.Max( 1, available / 3 ) : Math.Max( 1, available / 2 );

		takeCount = Math.Clamp( takeCount, 1, available );
		SetHeld( inv, slotIndex, itemId, takeCount );
	}

	bool TrySendToHotbar( global::Sandbox.VeggaInventory inv )
	{
		if ( inv == null || !inv.IsValid() )
			return false;
		if ( !HasSlotItem )
			return false;

		const int hotbarCount = 9;
		int itemId = inv.GetSlotItemId( SlotIndex );
		int count = inv.GetSlotCount( SlotIndex );
		if ( itemId <= 0 || count <= 0 )
			return false;

		// If it's already in the hotbar, no-op.
		if ( SlotIndex >= 0 && SlotIndex < hotbarCount )
			return false;

		var def = VeggaItemRegistry.Get( itemId );
		// Only allow action-bar items that are directly usable (consumables/equipment).
		if ( def != null && def.Category is not ItemCategory.Consumable and not ItemCategory.Equipment )
		{
			VeggaChatManager.Local?.AddLocalMessage( $"{def.Name} can't be placed on the action bar.", ChatMessageType.Error );
			return false;
		}
		int maxStack = VeggaInventory.GetEffectiveMaxStackForItem( itemId, def );

		int hotbarEnd = Math.Min( inv.TotalSlots - 1, hotbarCount - 1 );
		if ( hotbarEnd < 0 )
			return false;

		bool didMove = false;

		// 1) Prefer first empty hotbar slot (slot 1, then 2, etc.).
		for ( int i = 0; i <= hotbarEnd; i++ )
		{
			if ( i == SlotIndex ) continue;
			if ( inv.GetSlotItemId( i ) != 0 ) continue;
			RequestMoveSlotPredicted( inv, SlotIndex, i );
			return true;
		}

		// 2) Hotbar full: merge into existing stacks.
		if ( maxStack > 1 )
		{
			for ( int i = 0; i <= hotbarEnd; i++ )
			{
				if ( i == SlotIndex ) continue;
				if ( inv.GetSlotItemId( i ) != itemId ) continue;
				int c = inv.GetSlotCount( i );
				if ( c <= 0 || c >= maxStack ) continue;
				int canTake = Math.Max( 0, maxStack - c );
				int want = Math.Min( inv.GetSlotCount( SlotIndex ), canTake );
				if ( want <= 0 )
					continue;
				RequestMoveCountPredicted( inv, SlotIndex, i, want );
				didMove = true;
				break;
			}
		}

		return didMove;
	}

	bool TrySendToMainInventory( global::Sandbox.VeggaInventory inv )
	{
		if ( inv == null || !inv.IsValid() )
			return false;
		if ( !HasSlotItem )
			return false;

		const int hotbarCount = 9;
		const int mainStart = 9;
		if ( SlotIndex < 0 || SlotIndex >= hotbarCount )
			return false;
		if ( mainStart >= inv.TotalSlots )
			return false;

		int itemId = inv.GetSlotItemId( SlotIndex );
		int count = inv.GetSlotCount( SlotIndex );
		if ( itemId <= 0 || count <= 0 )
			return false;

		var def = VeggaItemRegistry.Get( itemId );
		int maxStack = VeggaInventory.GetEffectiveMaxStackForItem( itemId, def );

		// 1) Prefer first empty main slot.
		for ( int i = mainStart; i < inv.TotalSlots; i++ )
		{
			if ( inv.GetSlotItemId( i ) != 0 ) continue;
			RequestMoveSlotPredicted( inv, SlotIndex, i );
			return true;
		}

		// 2) If no empty slots, try merging.
		if ( maxStack > 1 )
		{
			for ( int i = mainStart; i < inv.TotalSlots; i++ )
			{
				if ( inv.GetSlotItemId( i ) != itemId ) continue;
				int c = inv.GetSlotCount( i );
				if ( c <= 0 || c >= maxStack ) continue;
				int canTake = Math.Max( 0, maxStack - c );
				int want = Math.Min( inv.GetSlotCount( SlotIndex ), canTake );
				if ( want <= 0 )
					continue;
				RequestMoveCountPredicted( inv, SlotIndex, i, want );
				return true;
			}
		}

		return false;
	}

	bool TryShiftQuickMove( global::Sandbox.VeggaInventory inv )
	{
		const int hotbarCount = 9;
		const int mainStart = 9;
		const int mainCount = 27;

		int itemId = inv.GetSlotItemId( SlotIndex );
		int count = inv.GetSlotCount( SlotIndex );
		if ( itemId <= 0 || count <= 0 )
			return false;

		var def = VeggaItemRegistry.Get( itemId );
		int maxStack = VeggaInventory.GetEffectiveMaxStackForItem( itemId, def );

		bool fromHotbar = SlotIndex >= 0 && SlotIndex < hotbarCount;
		bool fromMain = SlotIndex >= mainStart && SlotIndex < (mainStart + mainCount);
		if ( !fromHotbar && !fromMain )
			return false;

		int destStart = fromHotbar ? mainStart : 0;
		int destCount = fromHotbar ? mainCount : hotbarCount;
		int destEnd = Math.Min( inv.TotalSlots - 1, destStart + destCount - 1 );
		if ( destStart < 0 || destStart >= inv.TotalSlots )
			return false;
		if ( destEnd < destStart )
			return false;

		// 1) Fill existing stacks.
		if ( maxStack > 1 )
		{
			for ( int i = destStart; i <= destEnd; i++ )
			{
				if ( i == SlotIndex ) continue;
				if ( inv.GetSlotItemId( i ) != itemId ) continue;
				int c = inv.GetSlotCount( i );
				if ( c <= 0 || c >= maxStack ) continue;
				inv.RequestMoveCount( SlotIndex, i, inv.GetSlotCount( SlotIndex ) );
				if ( inv.GetSlotItemId( SlotIndex ) != itemId )
					break;
				if ( inv.GetSlotCount( SlotIndex ) <= 0 )
					break;
			}
		}

		// 2) If there's still something left, move it to first empty dest slot.
		if ( inv.GetSlotItemId( SlotIndex ) == itemId && inv.GetSlotCount( SlotIndex ) > 0 )
		{
			for ( int i = destStart; i <= destEnd; i++ )
			{
				if ( i == SlotIndex ) continue;
				if ( inv.GetSlotItemId( i ) != 0 ) continue;
				inv.RequestMoveSlot( SlotIndex, i );
				return true;
			}
			return false;
		}

		return true;
	}

	static void FillSlotToMaxFromOtherStacks( global::Sandbox.VeggaInventory inv, int targetSlot )
	{
		if ( inv == null || !inv.IsValid() ) return;
		int itemId = inv.GetSlotItemId( targetSlot );
		if ( itemId <= 0 ) return;
		var def = VeggaItemRegistry.Get( itemId );
		int maxStack = VeggaInventory.GetEffectiveMaxStackForItem( itemId, def );
		if ( maxStack <= 1 ) return;

		int current = inv.GetSlotCount( targetSlot );
		int need = maxStack - current;
		if ( need <= 0 ) return;

		for ( int i = 0; i < inv.TotalSlots && need > 0; i++ )
		{
			if ( i == targetSlot ) continue;
			if ( inv.GetSlotItemId( i ) != itemId ) continue;
			int fromCount = inv.GetSlotCount( i );
			if ( fromCount <= 0 ) continue;
			int move = Math.Min( need, fromCount );
			if ( move <= 0 ) continue;
			inv.RequestMoveCount( i, targetSlot, move );
			need = maxStack - inv.GetSlotCount( targetSlot );
		}
	}

	static void TryPlaceHeld( global::Sandbox.VeggaInventory inv, int targetSlot, MouseButtonKind button )
	{
		if ( !HasHeld ) return;
		if ( inv != _heldInventory ) return;
		if ( targetSlot < 0 || targetSlot >= inv.TotalSlots ) return;
		if ( _heldSourceSlotIndex < 0 || _heldSourceSlotIndex >= inv.TotalSlots ) { ClearHeld(); return; }

		int src = _heldSourceSlotIndex;
		int itemId = _heldItemId;
		if ( inv.GetSlotItemId( src ) != itemId || inv.GetSlotCount( src ) <= 0 ) { ClearHeld(); return; }

		int available = inv.GetSlotCount( src );
		int holding = Math.Clamp( _heldCount, 1, available );
		int want = holding;
		if ( button == MouseButtonKind.Right ) want = 1;

		int beforeCount = inv.GetSlotCount( src );
		int beforeItem = inv.GetSlotItemId( src );

		if ( want >= beforeCount && button == MouseButtonKind.Left )
		{
			RequestMoveSlotPredicted( inv, src, targetSlot );
			// Swaps can invalidate the held source immediately.
			ClearHeld();
			return;
		}

		RequestMoveCountPredicted( inv, src, targetSlot, want );

		int afterItem = inv.GetSlotItemId( src );
		int afterCount = afterItem == beforeItem ? inv.GetSlotCount( src ) : 0;
		int moved = Math.Max( 0, beforeCount - afterCount );
		_heldCount = Math.Max( 0, holding - moved );
		if ( _heldCount <= 0 )
			ClearHeld();
		else
			HeldUiRevision++;
	}

	protected override void OnDragStart( DragEvent e )
	{
		// If we're doing a manual RMB/MMB drag, suppress the native drag system.
		// Otherwise RMB-drag will behave like LMB and move the whole stack.
		if ( _manualRightOwner == this && _manualRightArmed ) return;
		if ( _manualSplitOwner == this && _manualSplitArmed ) return;

		if ( HasHeld ) return;
		if ( !HasItem ) return;
		if ( DebugNet ) Log.Info( $"[InvUI] DragStart slot={SlotIndex} itemId={ItemId} count={ItemCount} invProxy={Inventory?.Network?.IsProxy} local={Connection.Local?.Id}" );

		_dragSplit = false;
		_dragCount = ItemCount;
		_dragMode = DragMode.Full;

		// Right click drag: move/drop a single item from a stack.
		// (Depends on s&box drag system supporting mouse2 drags; if not, this will simply not trigger.)
		bool wantSingle = Input.Down( "Attack2" ) || Input.Down( "attack2" )
			|| Input.Down( "Crouch" ) || Input.Down( "crouch" );
		bool wantSplit = Input.Down( "InventorySplit" ) || Input.Down( "inventorysplit" );
		bool shiftDown = Input.Down( "Run" ) || Input.Down( "run" );
		bool wantSplitThird = wantSplit && shiftDown;
		bool wantSplitHalf = wantSplit && !shiftDown;

		if ( ItemCount > 1 )
		{
			var def = VeggaItemRegistry.Get( ItemId );
			int maxStack = VeggaInventory.GetEffectiveMaxStackForItem( ItemId, def );
			if ( maxStack > 1 )
			{
				if ( wantSingle )
				{
					_dragMode = DragMode.Single;
					_dragSplit = true;
					_dragCount = 1;
				}
				else if ( wantSplitHalf )
				{
					_dragMode = DragMode.SplitHalf;
					_dragSplit = true;
					_dragCount = Math.Max( 1, (ItemCount + 1) / 2 );
				}
				else if ( wantSplitThird )
				{
					_dragMode = DragMode.SplitThird;
					_dragSplit = true;
					_dragCount = Math.Max( 1, (ItemCount + 2) / 3 );
				}
			}
		}

		AddClass( "dragging" );

		// Ensure we never accumulate multiple drag ghosts.
		ClearActiveGhost();

		// Make a ghost panel (dragging this Panel itself can disturb layout).
		_ghost = new Panel();
		_ghost.Style.Position = PositionMode.Absolute;
		_ghost.Style.Width = 48;
		_ghost.Style.Height = 48;
		_ghost.Style.ZIndex = 4000;
		_ghost.Style.BackgroundColor = new Color( 0, 0, 0, 0.0f );
		_ghost.Style.PointerEvents = PointerEvents.None;

		var iconUrl = CssIconUrl;
		if ( !string.IsNullOrWhiteSpace( iconUrl ) )
		{
			var icon = new Panel();
			icon.Style.Width = 48;
			icon.Style.Height = 48;
			icon.Style.PointerEvents = PointerEvents.None;
			ApplyIconUrlVisualToPanel( icon, iconUrl, ItemId );
			_ghost.AddChild( icon );
		}
		else
		{
			var tex = VeggaItemThumbnailCache.GetOrCreateModelThumbnail( ModelPath );
			if ( tex is not null )
			{
				var icon = new Panel();
				icon.Style.Width = 48;
				icon.Style.Height = 48;
				icon.Style.PointerEvents = PointerEvents.None;
				icon.Style.SetBackgroundImage( tex );
				icon.Style.Set( "background-size", "contain" );
				icon.Style.Set( "background-repeat", "no-repeat" );
				icon.Style.Set( "background-position", "center" );
				_ghost.AddChild( icon );
			}
			else
			{
				// Fallback: simple "$" for cash or "?" for unknown.
				var label = new Label( IsCash ? "$" : "?" );
				label.Style.FontSize = 28;
				label.Style.FontWeight = 900;
				label.Style.FontColor = IsCash ? new Color( 0.9f, 0.75f, 0.15f, 1f ) : new Color( 1f, 1f, 1f, 1f );
				label.Style.AlignSelf = Align.Center;
				label.Style.PointerEvents = PointerEvents.None;
				_ghost.AddChild( label );
			}
		}

		FindRootPanel()?.AddChild( _ghost );
		_activeGhost = _ghost;
		_activeGhostOwner = this;
	}

	protected override void OnDrag( DragEvent e )
	{
		base.OnDrag( e );

		if ( !_ghost.IsValid() ) return;

		// Keep the ghost under cursor (screen -> panel space).
		_ghost.Style.Left = (e.ScreenPosition.x - e.LocalGrabPosition.x) * ScaleFromScreen;
		_ghost.Style.Top = (e.ScreenPosition.y - e.LocalGrabPosition.y) * ScaleFromScreen;

		// Hover highlight: mark the slot we're currently over.
		var root = FindRootPanel();
		if ( root == null ) return;
		var hover = root.Descendants.OfType<InventoryHudSlot>()
			.FirstOrDefault( x => x != null && x.IsValid() && x.IsInside( e.ScreenPosition ) );

		if ( hover != _lastHover )
		{
			_lastHover?.RemoveClass( "moving-to" );
			hover?.AddClass( "moving-to" );
			_lastHover = hover;
		}
	}

	protected override void OnDragEnd( DragEvent e )
	{
		base.OnDragEnd( e );
		RemoveClass( "dragging" );

		_lastHover?.RemoveClass( "moving-to" );
		_lastHover = null;

		if ( _activeGhostOwner == this )
			ClearActiveGhost();
		else if ( _ghost.IsValid() )
		{
			_ghost.Delete();
			_ghost = null;
		}

		var inv = Inventory;
		if ( inv == null || !inv.IsValid() || inv.Network?.IsProxy == true || inv.Network?.Owner != Connection.Local )
			inv = global::Sandbox.VeggaInventory.Local;
		if ( inv == null || !inv.IsValid() )
			return;

		// Drop target detection: find the slot under the cursor.
		var root = FindRootPanel();
		if ( root == null ) return;
		var target = FindSlotUnderCursorInDropZones( root, e.ScreenPosition );
		bool insideInv = IsInsidePanelByClass( root, "inventory-container", e.ScreenPosition );
		bool insideHotbar = IsInsidePanelByClass( root, "hotbar-root", e.ScreenPosition );
		bool outsideAll = !insideInv && !insideHotbar;

		if ( target == null )
		{
			// Only world-drop when released outside both containers.
			if ( outsideAll )
			{
				var dropCount = Math.Max( 1, _dragCount );
				if ( DebugNet ) Log.Info( $"[InvUI] DragEnd slot={SlotIndex} -> world drop count={dropCount} mode={_dragMode}" );
				inv.RequestDropFromSlot( SlotIndex, dropCount );
			}
			return;
		}

		// Split/single drags: allow moving count into empty slot OR merging into same-item stack.
		if ( _dragSplit )
		{
			int moveCount = Math.Max( 1, _dragCount );
			if ( DebugNet ) Log.Info( $"[InvUI] DragEnd move-count from={SlotIndex} to={target.SlotIndex} count={moveCount} mode={_dragMode}" );
			RequestMoveCountPredicted( inv, SlotIndex, target.SlotIndex, moveCount );
			return;
		}

		if ( DebugNet ) Log.Info( $"[InvUI] DragEnd move from={SlotIndex} to={target.SlotIndex}" );
		RequestMoveSlotPredicted( inv, SlotIndex, target.SlotIndex );
	}

	Panel FindInventoryGridPanel()
	{
		var p = Parent;
		while ( p != null )
		{
			if ( p.HasClass( "inventory-grid" ) )
				return p;
			p = p.Parent;
		}
		return null;
	}


	public static string ResolveCssUrl( string iconPath )
	{
		if ( string.IsNullOrWhiteSpace( iconPath ) )
			return null;

		iconPath = iconPath.Trim();
		if ( iconPath.StartsWith( "http://", StringComparison.OrdinalIgnoreCase )
			|| iconPath.StartsWith( "https://", StringComparison.OrdinalIgnoreCase ) )
		{
			return iconPath;
		}

		// For packaged content, s&box resolves paths like "ui/...".
		// Don't hard-fail on FileExists here: in some editor/package states the
		// mounted filesystem can lag behind and we'd incorrectly hide valid icons.
		var normalized = iconPath.TrimStart( '/' );
		if ( string.IsNullOrWhiteSpace( normalized ) )
			return null;
		if ( normalized.EndsWith( "/" ) )
			return null;
		// Basic sanity: require a file extension (eg .png/.jpg/.svg) to avoid engine spam.
		int lastSlash = normalized.LastIndexOf( '/' );
		int lastDot = normalized.LastIndexOf( '.' );
		if ( lastDot <= lastSlash )
			return null;

		// SVG icons are allowed, but ONLY if they exist.
		// This avoids the missing/empty spam that can happen if UI points at non-existent SVGs.
		if ( normalized.EndsWith( ".svg", StringComparison.OrdinalIgnoreCase ) )
		{
			try
			{
				return FileSystem.Mounted.FileExists( normalized ) ? normalized : null;
			}
			catch
			{
				return null;
			}
		}

		try
		{
			// Keep the check only as a soft hint for raster assets.
			// If it's missing, still return the path and let the UI attempt to load it.
			_ = FileSystem.Mounted.FileExists( normalized );
		}
		catch
		{
			// If FileSystem isn't available for some reason, fall back to returning the normalized path.
		}
		return normalized;
	}

	public override void OnDeleted()
	{
		base.OnDeleted();
		if ( _activeGhostOwner == this )
			ClearActiveGhost();
		else if ( _ghost.IsValid() )
		{
			_ghost.Delete();
			_ghost = null;
		}
		if ( _dragCaptureOwner == this )
			ClearDragCaptureOverlay();
		_lastHover = null;
		_iconPanel = null;
	}
}

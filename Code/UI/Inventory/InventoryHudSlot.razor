@using Sandbox
@using Sandbox.UI
@using System
@using System.Linq
@using Sandbox.Money
@namespace Sandbox.UI
@inherits Panel

<root>
	<label @ref="_iconPanel" class="item-icon"></label>
	<label @ref="_countPanel" class="item-count"></label>
</root>

@code
{
	static bool DebugNet => false;
	public static bool DebugInput { get; set; } = false;

	[ConCmd( "vegga_inv_debug", Help = "Toggle/Set inventory UI debug. Usage: vegga_inv_debug [0/1]" )]
	public static void CmdInvDebug( int enabled = -1 )
	{
		if ( enabled < 0 )
			DebugInput = !DebugInput;
		else
			DebugInput = enabled != 0;
		Log.Info( $"[InvUI] DebugInput={(DebugInput ? 1 : 0)}" );
	}
	public static int HoveredSlotIndex { get; private set; } = -1;
	public static global::Sandbox.VeggaInventory HoveredInventory { get; private set; }
	public static bool HasHoveredItem => HoveredInventory != null && HoveredInventory.IsValid() && HoveredSlotIndex >= 0 && HoveredSlotIndex < HoveredInventory.TotalSlots && HoveredInventory.GetSlotItemId( HoveredSlotIndex ) > 0;

	public static int HeldUiRevision { get; private set; } = 0;

	static Panel _activeGhost;
	static InventoryHudSlot _activeGhostOwner;
	static Panel _dragCapture;
	static InventoryHudSlot _dragCaptureOwner;

	class DragCaptureOverlay : Panel
	{
		protected override void OnMouseUp( MousePanelEvent e )
		{
			try { base.OnMouseUp( e ); }
			catch ( EntryPointNotFoundException ) { }
			InventoryHudSlot.FinalizeAnyActiveManualDrag();
		}
	}

	static void EnsureDragCaptureOverlay( Panel root, InventoryHudSlot owner )
	{
		if ( _dragCapture.IsValid() )
		{
			_dragCaptureOwner = owner;
			return;
		}

		if ( root == null || !root.IsValid() )
			return;

		var p = new DragCaptureOverlay();
		p.Style.Position = PositionMode.Absolute;
		p.Style.Left = 0;
		p.Style.Top = 0;
		p.Style.Width = Length.Percent( 100 );
		p.Style.Height = Length.Percent( 100 );
		p.Style.PointerEvents = PointerEvents.All;
		p.Style.BackgroundColor = new Color( 0, 0, 0, 0 );
		p.Style.ZIndex = 3500;
		root.AddChild( p );
		_dragCapture = p;
		_dragCaptureOwner = owner;
	}

	static void ClearDragCaptureOverlay()
	{
		if ( _dragCapture.IsValid() )
			_dragCapture.Delete();
		_dragCapture = null;
		_dragCaptureOwner = null;
	}

	static void FinalizeAnyActiveManualDrag()
	{
		// End active drags (preferred) or clear armed states (fallback).
		if ( _manualSplitOwner != null && _manualSplitOwner.IsValid() )
		{
			if ( _manualSplitOwner._manualSplitDragging )
				_manualSplitOwner.EndManualSplitDrag();
			else if ( _manualSplitOwner._manualSplitArmed )
			{
				_manualSplitOwner._manualSplitArmed = false;
				_manualSplitOwner = null;
			}
		}

		if ( _manualRightOwner != null && _manualRightOwner.IsValid() )
		{
			if ( _manualRightOwner._manualRightDragging )
				_manualRightOwner.EndManualRightDrag();
			else if ( _manualRightOwner._manualRightArmed )
			{
				_manualRightOwner._manualRightArmed = false;
				_manualRightOwner = null;
			}
		}

		if ( _manualLeftOwner != null && _manualLeftOwner.IsValid() )
		{
			if ( _manualLeftOwner._manualLeftDragging )
				_manualLeftOwner.EndManualLeftDrag();
			else if ( _manualLeftOwner._manualLeftArmed )
			{
				_manualLeftOwner._manualLeftArmed = false;
				_manualLeftOwner = null;
			}
		}

		ClearDragCaptureOverlay();
	}

	// Client-side prediction overlay for inventory moves.
	// We keep a snapshot and apply predicted operations to it so the UI updates instantly,
	// then drop prediction as soon as the replicated inventory Revision changes.
	static global::Sandbox.VeggaInventory _predInv;
	static int _predBaseRevision;
	static int _predTotalSlots;
	static int[] _predItemIds;
	static int[] _predItemCounts;
	static bool _predActive;

	static InventoryHudSlot _manualSplitOwner;
	static InventoryHudSlot _manualRightOwner;
	static InventoryHudSlot _manualLeftOwner;
	// Prevent first-click suppression on fresh level load: default values previously
	// caused clicks to be ignored for the first ~0.2s.
	static float _lastManualDragEndAt = -999f;
	static MouseButtonKind _lastManualDragEndButton = MouseButtonKind.Other;

	Label _countPanel;

	static void ClearActiveGhost()
	{
		if ( _activeGhost.IsValid() )
			_activeGhost.Delete();
		_activeGhost = null;
		_activeGhostOwner = null;
	}

	static void ClearPrediction()
	{
		_predInv = null;
		_predBaseRevision = 0;
		_predTotalSlots = 0;
		_predItemIds = null;
		_predItemCounts = null;
		_predActive = false;
	}

	static void EnsurePredictionSnapshot( global::Sandbox.VeggaInventory inv )
	{
		if ( inv == null || !inv.IsValid() )
		{
			ClearPrediction();
			return;
		}

		int total = inv.TotalSlots;
		if ( total <= 0 )
		{
			ClearPrediction();
			return;
		}

		bool needNew = !_predActive
			|| _predInv != inv
			|| _predItemIds == null
			|| _predItemCounts == null
			|| _predTotalSlots != total
			|| _predBaseRevision != inv.Revision;

		if ( !needNew )
			return;

		_predInv = inv;
		_predBaseRevision = inv.Revision;
		_predTotalSlots = total;
		_predItemIds = new int[total];
		_predItemCounts = new int[total];
		for ( int i = 0; i < total; i++ )
		{
			_predItemIds[i] = inv.GetSlotItemId( i );
			_predItemCounts[i] = inv.GetSlotCount( i );
		}
		_predActive = true;
	}

	static void EnsurePredictionValid( global::Sandbox.VeggaInventory inv )
	{
		if ( !_predActive )
			return;
		if ( inv == null || !inv.IsValid() || _predInv != inv )
		{
			ClearPrediction();
			return;
		}

		// As soon as authoritative state advances, stop predicting.
		if ( inv.Revision != _predBaseRevision )
			ClearPrediction();
	}

	static int GetEffectiveItemId( global::Sandbox.VeggaInventory inv, int slot )
	{
		if ( _predActive && inv == _predInv && slot >= 0 && slot < _predTotalSlots )
			return _predItemIds[slot];
		return inv.GetSlotItemId( slot );
	}

	static int GetEffectiveCount( global::Sandbox.VeggaInventory inv, int slot )
	{
		if ( _predActive && inv == _predInv && slot >= 0 && slot < _predTotalSlots )
			return _predItemCounts[slot];
		return inv.GetSlotCount( slot );
	}

	static void SetPredSlot( int slot, int itemId, int count )
	{
		if ( slot < 0 || slot >= _predTotalSlots ) return;
		if ( itemId <= 0 || count <= 0 )
		{
			_predItemIds[slot] = 0;
			_predItemCounts[slot] = 0;
			return;
		}
		_predItemIds[slot] = itemId;
		_predItemCounts[slot] = count;
	}

	static bool PredictMoveSlot( global::Sandbox.VeggaInventory inv, int fromIndex, int toIndex )
	{
		if ( fromIndex == toIndex ) return false;
		EnsurePredictionSnapshot( inv );
		if ( !_predActive ) return false;
		if ( fromIndex < 0 || fromIndex >= _predTotalSlots ) return false;
		if ( toIndex < 0 || toIndex >= _predTotalSlots ) return false;

		int fromItem = _predItemIds[fromIndex];
		int fromCount = _predItemCounts[fromIndex];
		if ( fromItem <= 0 || fromCount <= 0 ) return false;

		int toItem = _predItemIds[toIndex];
		int toCount = _predItemCounts[toIndex];

		// Match VeggaInventory.MoveSlotInternal: merge when same item.
		if ( toItem > 0 && toItem == fromItem && toCount > 0 )
		{
			var def = VeggaItemRegistry.Get( fromItem );
			int maxStack = VeggaInventory.GetEffectiveMaxStackForItem( fromItem, def );
			if ( maxStack > 1 )
			{
				long space = (long)maxStack - (long)toCount;
				if ( space > 0 )
				{
					int move = (int)Math.Min( space, (long)fromCount );
					SetPredSlot( toIndex, toItem, toCount + move );
					SetPredSlot( fromIndex, fromItem, fromCount - move );
					return true;
				}
			}
		}

		// Swap.
		SetPredSlot( fromIndex, toItem, toCount );
		SetPredSlot( toIndex, fromItem, fromCount );
		return true;
	}

	static bool PredictMoveCount( global::Sandbox.VeggaInventory inv, int fromIndex, int toIndex, int count )
	{
		if ( fromIndex == toIndex ) return false;
		if ( count <= 0 ) return false;
		EnsurePredictionSnapshot( inv );
		if ( !_predActive ) return false;
		if ( fromIndex < 0 || fromIndex >= _predTotalSlots ) return false;
		if ( toIndex < 0 || toIndex >= _predTotalSlots ) return false;

		int fromItem = _predItemIds[fromIndex];
		int fromCount = _predItemCounts[fromIndex];
		if ( fromItem <= 0 || fromCount <= 0 ) return false;
		if ( count > fromCount ) count = fromCount;
		if ( count >= fromCount )
			return PredictMoveSlot( inv, fromIndex, toIndex );

		int toItem = _predItemIds[toIndex];
		int toCount = _predItemCounts[toIndex];

		var def = VeggaItemRegistry.Get( fromItem );
		int maxStack = VeggaInventory.GetEffectiveMaxStackForItem( fromItem, def );
		if ( maxStack <= 1 ) return false;

		// Empty target: create new partial stack.
		if ( toItem <= 0 || toCount <= 0 )
		{
			SetPredSlot( fromIndex, fromItem, fromCount - count );
			SetPredSlot( toIndex, fromItem, count );
			return true;
		}

		// Same-item merge.
		if ( toItem == fromItem )
		{
			int space = Math.Max( 0, maxStack - toCount );
			if ( space <= 0 ) return false;
			int move = Math.Min( space, count );
			SetPredSlot( fromIndex, fromItem, fromCount - move );
			SetPredSlot( toIndex, toItem, toCount + move );
			return true;
		}

		return false;
	}

	static void RequestMoveSlotPredicted( global::Sandbox.VeggaInventory inv, int fromIndex, int toIndex )
	{
		if ( inv == null || !inv.IsValid() ) return;
		if ( fromIndex == toIndex ) return;
		if ( IsHotbarBlockedMove( inv, fromIndex, toIndex ) )
			return;
		if ( DebugInput ) Log.Info( $"[InvUI] ReqMoveSlot from={fromIndex} to={toIndex} rev={inv.Revision} predActive={_predActive}" );
		_ = PredictMoveSlot( inv, fromIndex, toIndex );
		HeldUiRevision++;
		inv.RequestMoveSlot( fromIndex, toIndex );
	}

	static void RequestMoveCountPredicted( global::Sandbox.VeggaInventory inv, int fromIndex, int toIndex, int count )
	{
		if ( inv == null || !inv.IsValid() ) return;
		if ( fromIndex == toIndex ) return;
		if ( IsHotbarBlockedMove( inv, fromIndex, toIndex ) )
			return;
		if ( DebugInput ) Log.Info( $"[InvUI] ReqMoveCount from={fromIndex} to={toIndex} count={count} rev={inv.Revision} predActive={_predActive}" );
		_ = PredictMoveCount( inv, fromIndex, toIndex, count );
		HeldUiRevision++;
		inv.RequestMoveCount( fromIndex, toIndex, count );
	}

	static bool IsHotbarBlockedMove( global::Sandbox.VeggaInventory inv, int fromIndex, int toIndex )
	{
		const int hotbarCount = 9;
		if ( toIndex < 0 || toIndex >= hotbarCount )
			return false;

		int itemId = GetEffectiveItemId( inv, fromIndex );
		if ( itemId <= 0 )
			return false;

		if ( itemId == VeggaCurrency.CashItemId )
		{
			VeggaChatManager.Local?.AddLocalMessage( "Money can't be placed on the action bar.", ChatMessageType.Error );
			return true;
		}

		var def = VeggaItemRegistry.Get( itemId );
		if ( def != null && (def.Category == ItemCategory.Currency || def.Category == ItemCategory.Quest) )
		{
			VeggaChatManager.Local?.AddLocalMessage( $"{def.Name} can't be placed on the action bar.", ChatMessageType.Error );
			return true;
		}

		return false;
	}

	static global::Sandbox.VeggaInventory _heldInventory;
	static int _heldSourceSlotIndex = -1;
	static int _heldItemId = 0;
	static int _heldCount = 0;
	static RealTimeSince _lastClickTime;
	static global::Sandbox.VeggaInventory _lastClickInventory;
	static int _lastClickSlotIndex = -1;
	static int _lastClickItemId = 0;

	static bool HasHeld
		=> _heldInventory != null
		&& _heldInventory.IsValid()
		&& _heldSourceSlotIndex >= 0
		&& _heldCount > 0
		&& _heldItemId > 0;

	static void ClearHeld()
	{
		_heldInventory = null;
		_heldSourceSlotIndex = -1;
		_heldItemId = 0;
		_heldCount = 0;
		HeldUiRevision++;
	}

	public static void CancelHeld()
	{
		if ( !HasHeld ) return;
		ClearHeld();
	}

	static void SetHeld( global::Sandbox.VeggaInventory inv, int sourceSlot, int itemId, int count )
	{
		if ( inv == null || !inv.IsValid() ) return;
		if ( sourceSlot < 0 || sourceSlot >= inv.TotalSlots ) return;
		if ( itemId <= 0 || count <= 0 ) return;
		_heldInventory = inv;
		_heldSourceSlotIndex = sourceSlot;
		_heldItemId = itemId;
		_heldCount = count;
		HeldUiRevision++;
	}

	enum MouseButtonKind
	{
		Left,
		Right,
		Middle,
		Other
	}

	static bool IsButtonStillDown( MouseButtonKind button )
	{
		// IMPORTANT: We use Input actions here only as a release-detection fallback.
		// Mouse-up events can be lost when releasing outside the UI, which makes drops feel "unstable".
		return button switch
		{
			MouseButtonKind.Left => Input.Down( "Attack1" ) || Input.Down( "attack1" ),
			MouseButtonKind.Right => Input.Down( "Attack2" ) || Input.Down( "attack2" ),
			MouseButtonKind.Middle => Input.Down( "InventorySplit" ) || Input.Down( "inventorysplit" ),
			_ => false
		};
	}

	static Panel FindFirstPanelByClass( Panel root, string className )
	{
		if ( root == null || string.IsNullOrWhiteSpace( className ) )
			return null;

		return root.Descendants.FirstOrDefault( p => p != null && p.IsValid() && p.HasClass( className ) );
	}

	static bool IsInsidePanelByClass( Panel root, string className, Vector2 screenPos )
	{
		var p = FindFirstPanelByClass( root, className );
		return p != null && p.IsValid() && p.IsInside( screenPos );
	}

	static InventoryHudSlot FindSlotUnderCursorInDropZones( Panel root, Vector2 screenPos )
	{
		if ( root == null )
			return null;

		var hotbar = FindFirstPanelByClass( root, "hotbar-root" );
		if ( hotbar != null && hotbar.IsValid() && hotbar.IsInside( screenPos ) )
		{
			return hotbar.Descendants.OfType<InventoryHudSlot>()
				.FirstOrDefault( x => x != null && x.IsValid() && x.IsInside( screenPos ) );
		}

		var grid = FindFirstPanelByClass( root, "inventory-grid" );
		if ( grid != null && grid.IsValid() && grid.IsInside( screenPos ) )
		{
			return grid.Descendants.OfType<InventoryHudSlot>()
				.FirstOrDefault( x => x != null && x.IsValid() && x.IsInside( screenPos ) );
		}

		return null;
	}

	static bool TryGetFurnaceDropSlot( Panel root, Vector2 screenPos, out int furnaceSlot )
	{
		furnaceSlot = -1;
		if ( root == null ) return false;
		if ( !WorldContainerUiContext.IsActive ) return false;
		if ( WorldContainerUiContext.ActiveKind != WorldContainerKind.Furnace ) return false;

		if ( IsInsidePanelByClass( root, "furnace-drop-fuel0", screenPos ) ) { furnaceSlot = global::Sandbox.VeggaFurnace.FuelSlot0; return true; }
		if ( IsInsidePanelByClass( root, "furnace-drop-fuel1", screenPos ) ) { furnaceSlot = global::Sandbox.VeggaFurnace.FuelSlot1; return true; }
		if ( IsInsidePanelByClass( root, "furnace-drop-fuel2", screenPos ) ) { furnaceSlot = global::Sandbox.VeggaFurnace.FuelSlot2; return true; }
		// Back-compat: older UI used a single furnace-drop-fuel.
		if ( IsInsidePanelByClass( root, "furnace-drop-fuel", screenPos ) ) { furnaceSlot = global::Sandbox.VeggaFurnace.FuelSlot0; return true; }
		if ( IsInsidePanelByClass( root, "furnace-drop-inputa", screenPos ) ) { furnaceSlot = global::Sandbox.VeggaFurnace.InputSlotA; return true; }
		if ( IsInsidePanelByClass( root, "furnace-drop-inputb", screenPos ) ) { furnaceSlot = global::Sandbox.VeggaFurnace.InputSlotB; return true; }
		if ( IsInsidePanelByClass( root, "furnace-drop-mould", screenPos ) ) { furnaceSlot = global::Sandbox.VeggaFurnace.MouldSlot; return true; }

		return false;
	}

	static bool IsAllowedItemForFurnaceSlot( int itemId, int furnaceSlot )
	{
		if ( itemId <= 0 ) return false;
		return furnaceSlot switch
		{
			global::Sandbox.VeggaFurnace.FuelSlot0 => itemId == VeggaItemIds.LogFull || itemId == VeggaItemIds.LogChopped,
			global::Sandbox.VeggaFurnace.FuelSlot1 => itemId == VeggaItemIds.LogFull || itemId == VeggaItemIds.LogChopped,
			global::Sandbox.VeggaFurnace.FuelSlot2 => itemId == VeggaItemIds.LogFull || itemId == VeggaItemIds.LogChopped,
			global::Sandbox.VeggaFurnace.MouldSlot => itemId == VeggaItemIds.MouldCoin || itemId == VeggaItemIds.MouldGoblet,
			global::Sandbox.VeggaFurnace.InputSlotA => itemId == VeggaItemIds.GoldOre
				|| itemId == VeggaItemIds.CoalOre
				|| itemId == VeggaItemIds.GoldBar200g
				|| itemId == VeggaItemIds.TinOre
				|| itemId == VeggaItemIds.CopperOre
				|| itemId == VeggaItemIds.IronOre
				|| itemId == VeggaItemIds.TinBar
				|| itemId == VeggaItemIds.CopperBar,
			global::Sandbox.VeggaFurnace.InputSlotB => itemId == VeggaItemIds.GoldOre
				|| itemId == VeggaItemIds.CoalOre
				|| itemId == VeggaItemIds.GoldBar200g
				|| itemId == VeggaItemIds.TinOre
				|| itemId == VeggaItemIds.CopperOre
				|| itemId == VeggaItemIds.IronOre
				|| itemId == VeggaItemIds.TinBar
				|| itemId == VeggaItemIds.CopperBar,
			_ => false
		};
	}

	static MouseButtonKind GetMouseButtonKind( MousePanelEvent e )
	{
		if ( e == null ) return MouseButtonKind.Left;

		// MousePanelEvent exposes a whitelist-safe Button field/property.
		// We avoid System.Reflection here because it is blocked by the sandbox whitelist.
		try
		{
			var rawString = (e.Button?.ToString() ?? "").Trim();
			var rawLower = rawString.ToLowerInvariant().Trim( '\'', '"' );

			// Name-based mapping (covers enum names like Left/Right/Middle, Primary/Secondary, Mouse1/Mouse2, etc.)
			// NOTE: s&box often reports strings like "mouseleft"/"mouseright"/"mousemiddle".
			if ( rawLower is "left" or "primary" or "mouse1" or "mouse0" or "button0" or "mouseleft" )
				return MouseButtonKind.Left;
			if ( rawLower is "right" or "secondary" or "mouse2" or "button2" or "mouseright" )
				return MouseButtonKind.Right;
			if ( rawLower is "middle" or "wheel" or "mouse3" or "button1" or "mousemiddle" )
				return MouseButtonKind.Middle;

			// Some drivers / UI layers include extra suffix/prefix text.
			// Prefer a permissive contains-based mapping over falling back to "Left".
			if ( rawLower.Contains( "right", StringComparison.Ordinal ) )
				return MouseButtonKind.Right;
			if ( rawLower.Contains( "middle", StringComparison.Ordinal ) )
				return MouseButtonKind.Middle;
			if ( rawLower.Contains( "left", StringComparison.Ordinal ) )
				return MouseButtonKind.Left;

			// Fallback: try numeric enum value (common in engine enums)
			// UI event systems commonly use 0=Left, 1=Middle, 2=Right.
			// If the engine provides named strings, we'll have already matched above.
			int i = Convert.ToInt32( e.Button );
			return i switch
			{
				0 => MouseButtonKind.Left,
				1 => MouseButtonKind.Middle,
				2 => MouseButtonKind.Right,
				_ => MouseButtonKind.Other
			};
		}
		catch
		{
			// fall through
		}

		return MouseButtonKind.Left;
	}

	enum DragMode
	{
		Full,
		SplitHalf,
		SplitThird,
		Single
	}

	[Parameter] public global::Sandbox.VeggaInventory Inventory { get; set; }
	[Parameter] public int SlotIndex { get; set; }
	[Parameter] public bool IsSelected { get; set; }
	[Parameter] public Action<int> OnSelected { get; set; }

	Panel _ghost;
	Label _iconPanel;
	InventoryHudSlot _lastHover;
	int _dragCount;
	bool _dragSplit;
	string _lastVisualKey;
	bool _hasRenderedThumb;
	DragMode _dragMode;

	bool _manualSplitArmed;
	bool _manualSplitDragging;
	Vector2 _manualSplitStartScreen;
	bool _manualSplitShift;
	int _manualSplitCount;

	bool _manualRightArmed;
	bool _manualRightDragging;
	Vector2 _manualRightStartScreen;

	bool _manualLeftArmed;
	bool _manualLeftDragging;
	Vector2 _manualLeftStartScreen;

	bool HasSlotItem
		=> Inventory != null
		&& Inventory.IsValid()
		&& SlotIndex >= 0
		&& SlotIndex < Inventory.TotalSlots
		&& GetEffectiveItemId( Inventory, SlotIndex ) > 0;
	int SlotItemId => HasSlotItem ? GetEffectiveItemId( Inventory, SlotIndex ) : 0;
	int SlotItemCount => HasSlotItem ? GetEffectiveCount( Inventory, SlotIndex ) : 0;
	int HeldReservedCount
	{
		get
		{
			if ( !HasHeld ) return 0;
			if ( Inventory != _heldInventory ) return 0;
			if ( SlotIndex != _heldSourceSlotIndex ) return 0;
			if ( SlotItemId != _heldItemId ) return 0;
			return Math.Clamp( _heldCount, 0, SlotItemCount );
		}
	}
	int VisibleCount => HasSlotItem ? Math.Max( 0, SlotItemCount - HeldReservedCount ) : 0;
	bool HasItem => VisibleCount > 0;
	int ItemId => HasItem ? SlotItemId : 0;
	int ItemCount => HasItem ? VisibleCount : 0;
	bool IsCash => ItemId == VeggaCurrency.CashItemId;
	string CssIconUrl
	{
		get
		{
			if ( !HasItem ) return null;
			var def = VeggaItemRegistry.Get( ItemId );
			return ResolveCssUrl( def?.IconPath );
		}
	}
	string ModelPath
	{
		get
		{
			if ( !HasItem ) return null;

			// Cash uses tiered visual models (same as world drops) so its thumbnail
			// looks like an actual bill/stack/box.
			if ( IsCash )
			{
				// Use the underlying slot count so the visual doesn't flicker due to held-reserve math.
				int amount = Math.Max( 1, SlotItemCount );
				return VeggaCurrency.GetCashModelPathForAmount( amount );
			}

			var def = VeggaItemRegistry.Get( ItemId );
			return def?.ModelPath;
		}
	}

	bool IsNoted
	{
		get
		{
			if ( !HasItem ) return false;
			var def = VeggaItemRegistry.Get( ItemId );
			return def != null && string.Equals( def.PrefabPath, "noted_page.prefab", StringComparison.OrdinalIgnoreCase );
		}
	}

	static void ClearIconMaskTint( Panel panel )
	{
		if ( panel == null || !panel.IsValid() )
			return;
		panel.Style.Set( "background-color", "transparent" );
		panel.Style.Set( "mask-image", "none" );
		panel.Style.Set( "-webkit-mask-image", "none" );
		panel.Style.Set( "mask-repeat", "no-repeat" );
		panel.Style.Set( "-webkit-mask-repeat", "no-repeat" );
		panel.Style.Set( "mask-size", "contain" );
		panel.Style.Set( "-webkit-mask-size", "contain" );
		panel.Style.Set( "mask-position", "center" );
		panel.Style.Set( "-webkit-mask-position", "center" );
	}

	static void ApplyNotedMaskTint( Panel panel, string iconUrl )
	{
		if ( panel == null || !panel.IsValid() )
			return;
		if ( string.IsNullOrWhiteSpace( iconUrl ) )
			return;

		panel.Style.Set( "background-image", "none" );
		// Noted items only: yellow tint
		panel.Style.Set( "background-color", "#eab308" );
		panel.Style.Set( "mask-image", $"url('{iconUrl}')" );
		panel.Style.Set( "-webkit-mask-image", $"url('{iconUrl}')" );
		panel.Style.Set( "mask-repeat", "no-repeat" );
		panel.Style.Set( "-webkit-mask-repeat", "no-repeat" );
		panel.Style.Set( "mask-size", "contain" );
		panel.Style.Set( "-webkit-mask-size", "contain" );
		panel.Style.Set( "mask-position", "center" );
		panel.Style.Set( "-webkit-mask-position", "center" );
	}

	void ApplyIconUrlVisualToPanel( Panel iconPanel, string iconUrl, int itemId )
	{
		if ( iconPanel == null || !iconPanel.IsValid() )
			return;
		if ( string.IsNullOrWhiteSpace( iconUrl ) )
			return;

		var def = VeggaItemRegistry.Get( itemId );
		bool isNoted = def != null && string.Equals( def.PrefabPath, "noted_page.prefab", StringComparison.OrdinalIgnoreCase );
		if ( isNoted )
		{
			ApplyNotedMaskTint( iconPanel, iconUrl );
			return;
		}

		ClearIconMaskTint( iconPanel );
		iconPanel.Style.Set( "background-image", $"url('{iconUrl}')" );
		iconPanel.Style.Set( "background-size", "contain" );
		iconPanel.Style.Set( "background-repeat", "no-repeat" );
		iconPanel.Style.Set( "background-position", "center" );
		ApplyIconTint( iconPanel, itemId );
	}

	string IconText
	{
		get
		{
			// Only show text if we don't have an icon OR a rendered thumbnail.
			if ( !string.IsNullOrWhiteSpace( CssIconUrl ) ) return string.Empty;
			if ( _hasRenderedThumb ) return string.Empty;

			if ( IsCash ) return "$";
			return "?";
		}
	}

	// Disable the built-in drag system entirely.
	// We rely on our manual drag paths so RMB/MMB can never fall through to native drag
	// (which always behaves like full-stack and was causing the "RMB drag takes whole stack" UX).
	public override bool WantsDrag => false;

	public override void Tick()
	{
		base.Tick();
		EnsurePredictionValid( Inventory );
		TickManualSplitDrag();
		TickManualRightDrag();
		TickManualLeftDrag();

		// Keep visuals in sync with replicated inventory state.
		// (Slots are Panels, not PanelComponents; relying on Razor re-render alone can be stale.)
		SetClass( "inventory-slot", true );
		SetClass( "has-item", HasItem );
		SetClass( "selected", HasItem && IsSelected );
		UpdateIconVisual();
	}

	void TickManualLeftDrag()
	{
		// Manual left-drag: move/swap the full stack.
		if ( _manualLeftOwner != this )
			return;
		if ( !_manualLeftArmed && !_manualLeftDragging )
			return;

		var mouse = Mouse.Position;
		var delta = mouse - _manualLeftStartScreen;
		float dist2 = delta.LengthSquared;
		const float startThreshold2 = 6f * 6f;

		if ( !_manualLeftDragging )
		{
			if ( dist2 < startThreshold2 )
				return;

			StartManualLeftDrag();
		}

		if ( _ghost.IsValid() )
		{
			_ghost.Style.Left = (mouse.x - 24f) * ScaleFromScreen;
			_ghost.Style.Top = (mouse.y - 24f) * ScaleFromScreen;
			_ghost.Style.Dirty();
		}

		var root = FindRootPanel();
		if ( root == null )
			return;

		var hover = root.Descendants.OfType<InventoryHudSlot>()
			.FirstOrDefault( x => x != null && x.IsValid() && x.IsInside( mouse ) );

		if ( hover != _lastHover )
		{
			_lastHover?.RemoveClass( "moving-to" );
			hover?.AddClass( "moving-to" );
			_lastHover = hover;
		}
	}

	void StartManualLeftDrag()
	{
		_manualLeftDragging = true;
		AddClass( "dragging" );

		var root = FindRootPanel();
		EnsureDragCaptureOverlay( root, this );

		ClearActiveGhost();

		_ghost = new Panel();
		_ghost.Style.Position = PositionMode.Absolute;
		_ghost.Style.Width = 48;
		_ghost.Style.Height = 48;
		_ghost.Style.ZIndex = 4000;
		_ghost.Style.BackgroundColor = new Color( 0, 0, 0, 0.0f );
		_ghost.Style.PointerEvents = PointerEvents.None;

		var iconUrl = CssIconUrl;
		if ( !string.IsNullOrWhiteSpace( iconUrl ) )
		{
			var icon = new Panel();
			icon.Style.Width = 48;
			icon.Style.Height = 48;
			icon.Style.PointerEvents = PointerEvents.None;
			ApplyIconUrlVisualToPanel( icon, iconUrl, ItemId );
			_ghost.AddChild( icon );
		}
		else
		{
			var tex = VeggaItemThumbnailCache.GetOrCreateModelThumbnail( ModelPath );
			if ( tex is not null )
			{
				var icon = new Panel();
				icon.Style.Width = 48;
				icon.Style.Height = 48;
				icon.Style.PointerEvents = PointerEvents.None;
				icon.Style.SetBackgroundImage( tex );
				icon.Style.Set( "background-size", "contain" );
				icon.Style.Set( "background-repeat", "no-repeat" );
				icon.Style.Set( "background-position", "center" );
				ApplyIconTint( icon, ItemId );
				_ghost.AddChild( icon );
			}
			else
			{
				var label = new Label( IsCash ? "$" : "?" );
				label.Style.FontSize = 28;
				label.Style.FontWeight = 900;
				label.Style.FontColor = IsCash ? new Color( 0.9f, 0.75f, 0.15f, 1f ) : new Color( 1f, 1f, 1f, 1f );
				label.Style.AlignSelf = Align.Center;
				label.Style.PointerEvents = PointerEvents.None;
				_ghost.AddChild( label );
			}
		}

		FindRootPanel()?.AddChild( _ghost );
		_activeGhost = _ghost;
		_activeGhostOwner = this;
	}

	void EndManualLeftDrag()
	{
		_lastManualDragEndAt = Time.Now;
		_lastManualDragEndButton = MouseButtonKind.Left;

		_manualLeftDragging = false;
		_manualLeftArmed = false;
		_manualLeftOwner = null;
		RemoveClass( "dragging" );
		ClearDragCaptureOverlay();

		_lastHover?.RemoveClass( "moving-to" );
		_lastHover = null;

		if ( _activeGhostOwner == this )
			ClearActiveGhost();
		else if ( _ghost.IsValid() )
		{
			_ghost.Delete();
			_ghost = null;
		}

		var inv = Inventory;
		if ( inv == null || !inv.IsValid() || inv.Network?.IsProxy == true || inv.Network?.Owner != Connection.Local )
			inv = global::Sandbox.VeggaInventory.Local;
		if ( inv == null || !inv.IsValid() )
			return;

		var mouse = Mouse.Position;
		var root = FindRootPanel();
		var target = FindSlotUnderCursorInDropZones( root, mouse );
		bool insideInv = IsInsidePanelByClass( root, "inventory-container", mouse );
		bool insideHotbar = IsInsidePanelByClass( root, "hotbar-root", mouse );
		bool outsideAll = !insideInv && !insideHotbar;

		if ( target == null )
		{
			if ( TryGetFurnaceDropSlot( root, mouse, out var furnaceSlot ) )
			{
				if ( !IsAllowedItemForFurnaceSlot( SlotItemId, furnaceSlot ) )
				{
					var def = VeggaItemRegistry.Get( SlotItemId );
					string name = def?.Name ?? $"Item {SlotItemId}";
					VeggaChatManager.Local?.AddLocalMessage( $"{name} can't be placed in that furnace slot.", ChatMessageType.Error );
					return;
				}

				bool ok = WorldContainerUiContext.TryDepositFromPlayerInventoryToFurnaceSlot( inv, SlotIndex, SlotItemCount, furnaceSlot );
				if ( !ok )
					VeggaChatManager.Local?.AddLocalMessage( "Furnace slot can't accept that right now.", ChatMessageType.Error );
				return;
			}

			// Only world-drop when released outside both containers.
			if ( outsideAll )
				inv.RequestDropFromSlot( SlotIndex, SlotItemCount );
			return;
		}

		if ( target.SlotIndex == SlotIndex )
			return;

		RequestMoveSlotPredicted( inv, SlotIndex, target.SlotIndex );
	}


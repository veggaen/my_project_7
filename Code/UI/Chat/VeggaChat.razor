@using Sandbox
@using Sandbox.UI
@using System
@using System.Collections.Generic
@using System.Linq
@namespace Sandbox.UI
@inherits PanelComponent
@attribute [StyleSheet( "/code/ui/chat/veggachat.razor.scss" )]

<root>
	<div class="chat-container-outer">
	<div class="chat-container @(_isOpen ? "open" : "closed") @(_isFocused ? "focused" : "")">
		@* Pinned message *@
		@if ( TryGetPinned( out var pinned, out var pinnedLikes ) )
		{
			<div class="pinned">
				<div class="pinned-header">
					<span class="pin-label">PINNED</span>
					<span class="spacer"></span>
					<span class="pin-likes">♥ @pinnedLikes</span>
				</div>
				<div class="pinned-body">
					@if ( pinned.SenderSteamId != 0 )
					{
						<span class="avatar" style=@($"background-image: url(avatar:{pinned.SenderSteamId});")></span>
					}
					<span class="pinned-sender">@pinned.SenderName</span>
					<span class="pinned-text">@pinned.Text</span>
				</div>
			</div>
		}

		@* Messages *@
		<scrollpanel class="messages-container"
					 @ref="_messagesPanel"
					 @onmouseenter=@(() => SetMessagesHover( true ))
					 @onmouseleave=@(() => SetMessagesHover( false ))>
			@* Hovering messages enables scrollback without entering write mode *@
			@foreach ( var msg in GetVisibleMessages() )
			{
				<div class="message @GetMessageClass(msg)" @key="msg.MessageId">
					<div class="message-header">
						@if ( ShouldShowBadge( msg, out var badgeText ) )
						{
							<span class="badge">@badgeText</span>
						}
						@if ( msg.Type == ChatMessageType.Normal || msg.Type == ChatMessageType.Private )
						{
							@if ( msg.SenderSteamId != 0 )
							{
								<span class="avatar" style=@($"background-image: url(avatar:{msg.SenderSteamId});")></span>
							}
							<span class="sender">@msg.SenderName</span>
						}
						<span class="spacer"></span>
						@if ( msg.Type == ChatMessageType.Normal )
						{
							var likeCount = GetReactionCount( msg, "like" );
							<button class="reaction-btn inline" @onclick=@(() => SendReaction( msg, "like" ))>
								<span class="icon">♥</span>
								@if ( likeCount > 0 )
								{
									<span class="count">@likeCount</span>
								}
							</button>
						}
						<span class="time">@msg.Time.ToString("HH:mm")</span>
					</div>
					<div class="message-body">
						<span class="text">@msg.Text</span>
					</div>
				</div>
			}
		</scrollpanel>

		
	</div>
	<div class="chat-input-outer @(_isFocused ? "focused" : "")">
		@* Footer *@
		@if ( _isFocused )
		{
			<div class="chat-footer">
				@if ( _suggestions.Count > 0 )
				{
					<div class="suggestions">
						@for ( int i = 0; i < _suggestions.Count; i++ )
						{
							var s = _suggestions[i];
							<div class="suggestion-item @(i == _selectedSuggestionIndex ? "selected" : "")"
								 @onclick=@(() => AcceptSuggestion( i ))
								 @onmouseover=@(() => _selectedSuggestionIndex = i)>
								<span class="kind">@s.Kind</span>
								<span class="main">@s.Main</span>
								<span class="desc">@s.Desc</span>
							</div>
						}
					</div>
				}

				<div class="chat-input-row">
					<span class="input-prefix">Say:</span>
					<textentry class="input-entry" @ref="_textEntry" />
				</div>
			</div>
		}
		else
		{
			<div class="chat-hint">Press Enter to chat</div>
		}
	</div>
	</div>
</root>

@code
{
	Panel _messagesPanel;
	TextEntry _textEntry;
	VeggaChatManager _chatManager;
	List<ChatMessage> _messages = new();
	readonly List<string> _sentHistory = new();
	int _historyIndex = -1; // 0 = most recent
	string _historyDraft = "";

	bool _isOpen = true;
	bool _isFocused = false;
	bool _wasFocused = false;
	public static bool IsChatInputOpenGlobal { get; private set; }
	static VeggaChat _instance;
	string _inputText = "";
	bool _wantFocusEntry = false;
	float _lastMessageTime = 0f;
	bool _pendingScrollToBottom = false;
	bool _capturingBottomScroll = false;
	float _bottomScrollY = 0f;
	bool _lockToHistoryScroll = false;
	bool _isHoveringMessages = false;

	const int FocusedTakeInitial = 60;
	const int FocusedTakeStep = 40;
	int _focusedTake = FocusedTakeInitial;
	float _nextFocusedTakeIncreaseTime = 0f;

	const int HoverTakeInitial = 60;
	const int HoverTakeStep = 60;
	int _hoverTake = HoverTakeInitial;
	float _nextHoverTakeIncreaseTime = 0f;

	readonly List<ChatSuggestion> _suggestions = new();
	int _selectedSuggestionIndex = 0;
	int _messagesVersion = 0;

	// Layout integration
	Vector2 _layoutPos = new Vector2( 0.02f, 0.80f );
	float _layoutScale = 1f;
	string ChatKey => VeggaHudLayoutState.KeyChat;
	bool IsLayoutActive => VeggaHudLayoutState.IsActive;

	protected override void OnStart()
	{
		_instance = this;
		// Statics can survive hot reloads; ensure we start from a sane state.
		IsChatInputOpenGlobal = _isFocused;
		_wasFocused = _isFocused;
		VeggaUiCloseStack.SetOpen( VeggaUiCloseStack.KeyChatInput, _isFocused, CloseSelfFromEscape );
		_chatManager = VeggaChatManager.Local;
		if ( _chatManager != null )
		{
			_chatManager.OnMessageReceived += OnMessageReceived;
			_chatManager.OnMessagesChanged += OnMessagesChanged;
		}

		// Ensure we render existing history immediately and land at the bottom.
		_pendingScrollToBottom = true;

		// Load saved layout position
		_layoutPos = VeggaHudLayoutState.GetPosition( ChatKey, _layoutPos );
		_layoutScale = VeggaHudLayoutState.GetScale( ChatKey, 1f );
	}

	public static void ForceClose()
	{
		CancelTypingFromEscape();
	}

	public static void CancelTypingFromEscape()
	{
		_instance?.CloseSelfFromEscape();
	}

	void CloseSelfFromEscape()
	{
		CloseChatInput();
		_isFocused = false;
		_wasFocused = false;
		IsChatInputOpenGlobal = false;
		VeggaUiCloseStack.Remove( VeggaUiCloseStack.KeyChatInput );
		StateHasChanged();
	}

	protected override void OnDestroy()
	{
		base.OnDestroy();
		if ( _instance == this )
			_instance = null;
		IsChatInputOpenGlobal = false;
		_isFocused = false;
		_wasFocused = false;
		_wantFocusEntry = false;
		VeggaUiCloseStack.Remove( VeggaUiCloseStack.KeyChatInput );
	}

	protected override void OnUpdate()
	{
		// Keep the global flag in sync every frame (prevents "stuck UI mouse" after hot reload).
		IsChatInputOpenGlobal = _isFocused;
		if ( _isFocused != _wasFocused )
		{
			VeggaUiCloseStack.SetOpen( VeggaUiCloseStack.KeyChatInput, _isFocused, CloseSelfFromEscape );
			_wasFocused = _isFocused;
		}

		// Find chat manager if not yet found
		if ( _chatManager == null )
		{
			_chatManager = VeggaChatManager.Local;
			if ( _chatManager != null )
			{
				_chatManager.OnMessageReceived += OnMessageReceived;
				_chatManager.OnMessagesChanged += OnMessagesChanged;
			}
		}

		static bool ChatPressed()
		{
			// ProjectSettings/Input.config defines "Chat" (capital C)
			// Keep a lowercase fallback in case another system uses it.
			return Input.Pressed( "Chat" ) || Input.Pressed( "chat" );
		}

		// Handle input
		if ( _isFocused )
		{
			// Keep our backing string in sync (BuildHash uses it).
			if ( _textEntry != null )
			{
				try
				{
					_inputText = _textEntry.Text ?? "";
				}
				catch ( Exception )
				{
					// If the TextEntry got destroyed during a re-render, drop the ref and keep going.
					_textEntry = null;
				}
				if ( _wantFocusEntry )
				{
					try
					{
						_textEntry.Focus();
					}
					catch ( Exception )
					{
						// Can happen if the text entry reference is stale during a re-render.
					}
					_wantFocusEntry = false;
				}
			}

			UpdateSuggestions();

			// Submit on Enter (or accept suggestion)
			if ( ChatPressed() )
			{
				var current = (_inputText ?? "").Trim();
				bool allowSubmitEvenWithSuggestions =
					current.Equals( "!hex", StringComparison.OrdinalIgnoreCase )
					|| current.Equals( "/hex", StringComparison.OrdinalIgnoreCase )
					|| (current.StartsWith( "!", StringComparison.Ordinal ) || current.StartsWith( "/", StringComparison.Ordinal ))
						&& current.Contains( ' ' );

				if ( _suggestions.Count > 0 && !allowSubmitEvenWithSuggestions )
					AcceptSuggestion( _selectedSuggestionIndex );
				else
					SubmitMessage();
			}

			// Cancel on Escape
			// (Escape is handled by the centralized close-stack)
		}
		else
		{
			// Open chat on T
			if ( ChatPressed() )
			{
				OpenChatInput();
			}
		}

		// Keep chat visible even when not focused so players can always read it.
		_isOpen = true;

		// Pull latest layout position/scale so HUD editor presets apply live
		var latestPos = VeggaHudLayoutState.GetPosition( ChatKey, _layoutPos );
		var latestScale = VeggaHudLayoutState.GetScale( ChatKey, _layoutScale );
		if ( latestPos != _layoutPos )
			_layoutPos = latestPos;
		if ( Math.Abs( latestScale - _layoutScale ) > 0.0001f )
			_layoutScale = latestScale;

		ApplyLayoutPosition();

		// Allow mouse interactions (eg. reactions) without forcing chat focus.
		if ( Panel != null )
		{
			Panel.Style.PointerEvents = PointerEvents.All;
		}

		// Capture a stable "bottom" scroll position so manual scroll-up doesn't get yanked back.
		if ( _messagesPanel != null )
		{
			try
			{
				if ( _pendingScrollToBottom )
				{
					ScrollToBottom();
					_pendingScrollToBottom = false;
					_capturingBottomScroll = true;
					_lockToHistoryScroll = false;
				}
				else if ( _capturingBottomScroll )
				{
					_bottomScrollY = _messagesPanel.ScrollOffset.y;
					_capturingBottomScroll = false;
				}
				else if ( _isFocused || _isHoveringMessages )
				{
					var y = _messagesPanel.ScrollOffset.y;
					// If the user scrolls up from the last known bottom, lock auto-scroll until they return.
					if ( !_lockToHistoryScroll && y < _bottomScrollY - 10f )
						_lockToHistoryScroll = true;
					if ( _lockToHistoryScroll && y >= _bottomScrollY - 10f )
						_lockToHistoryScroll = false;

					// Focused/hover mode: if user scrolls to the very top, increase how many messages we render.
					if ( _lockToHistoryScroll && y <= 20f )
					{
						if ( _isFocused )
							TryIncreaseFocusedTake();
						else
							TryIncreaseHoverTake();
					}
				}
			}
			catch ( Exception )
			{
				// Panel refs can go stale during hot reload / re-render.
				_messagesPanel = null;
				_pendingScrollToBottom = false;
				_capturingBottomScroll = false;
				_lockToHistoryScroll = false;
			}
		}
	}

	void SetMessagesHover( bool isHovering )
	{
		if ( _isHoveringMessages == isHovering )
			return;

		_isHoveringMessages = isHovering;
		if ( _isHoveringMessages )
		{
			_hoverTake = HoverTakeInitial;
			// Don't force-scroll here; let the user keep their position and scroll naturally.
		}
		else
		{
			// When leaving hover, snap back to bottom and keep viewer-mode compact.
			_pendingScrollToBottom = true;
			_capturingBottomScroll = false;
			_lockToHistoryScroll = false;
		}

		StateHasChanged();
	}

	void OpenChatInput()
	{
		_isFocused = true;
		_isOpen = true;
		IsChatInputOpenGlobal = true;
		VeggaUiCloseStack.SetOpen( VeggaUiCloseStack.KeyChatInput, true, CloseSelfFromEscape );
		_wasFocused = true;
		_inputText = "";
		_historyIndex = -1;
		_historyDraft = "";
		_focusedTake = FocusedTakeInitial;
		_wantFocusEntry = true;
		_suggestions.Clear();
		_selectedSuggestionIndex = 0;
		_pendingScrollToBottom = true;
		_capturingBottomScroll = false;
		_lockToHistoryScroll = false;
	}

	void TryIncreaseFocusedTake()
	{
		if ( !_isFocused ) return;
		if ( _chatManager == null ) return;
		if ( Time.Now < _nextFocusedTakeIncreaseTime ) return;

		var cap = _chatManager.MaxMessages > 0 ? _chatManager.MaxMessages : 100;
		cap = Math.Min( cap, _chatManager.Messages.Count );
		if ( cap <= 0 ) return;

		var next = Math.Min( cap, _focusedTake + FocusedTakeStep );
		if ( next == _focusedTake ) return;

		_focusedTake = next;
		_nextFocusedTakeIncreaseTime = Time.Now + 0.15f;
		StateHasChanged();
	}

	void TryIncreaseHoverTake()
	{
		if ( _isFocused ) return;
		if ( !_isHoveringMessages ) return;
		if ( _chatManager == null ) return;
		if ( Time.Now < _nextHoverTakeIncreaseTime ) return;

		var cap = _chatManager.MaxMessages > 0 ? _chatManager.MaxMessages : 100;
		cap = Math.Min( cap, _chatManager.Messages.Count );
		if ( cap <= 0 ) return;

		var next = Math.Min( cap, _hoverTake + HoverTakeStep );
		if ( next == _hoverTake ) return;

		_hoverTake = next;
		_nextHoverTakeIncreaseTime = Time.Now + 0.15f;
		StateHasChanged();
	}

	void CloseChatInput()
	{
		_isFocused = false;
		IsChatInputOpenGlobal = false;
		VeggaUiCloseStack.Remove( VeggaUiCloseStack.KeyChatInput );
		_wasFocused = false;
		_inputText = "";
		_historyIndex = -1;
		_historyDraft = "";
		_wantFocusEntry = false;
		_suggestions.Clear();
		_selectedSuggestionIndex = 0;
		_textEntry = null;
	}

	void SubmitMessage()
	{
		// Prefer the live TextEntry value; _inputText can lag behind in some UI timing cases.
		var text = (_textEntry?.Text ?? _inputText) ?? "";
		_inputText = text;
		if ( !string.IsNullOrWhiteSpace( text ) )
		{
			try
			{
				_chatManager?.SendMessage( text );
				AddToHistory( text );
			}
			catch ( Exception ex )
			{
				_chatManager?.AddLocalMessage( $"Failed to send chat: {ex.Message}", ChatMessageType.Error );
				Log.Warning( ex, "[VeggaChat] SendMessage failed" );
			}
		}

		CloseChatInput();
	}

	void AddToHistory( string text )
	{
		text = text?.TrimEnd() ?? "";
		if ( string.IsNullOrWhiteSpace( text ) ) return;
		if ( _sentHistory.Count > 0 && string.Equals( _sentHistory[^1], text, StringComparison.Ordinal ) )
			return;
		_sentHistory.Add( text );
		while ( _sentHistory.Count > 50 )
			_sentHistory.RemoveAt( 0 );
		_historyIndex = -1;
		_historyDraft = "";
	}

	void OnTextEntryKeyDown( int key )
	{
		if ( !_isFocused || _textEntry == null ) return;
		if ( _sentHistory.Count == 0 ) return;

		// Key codes here follow the UI keydown event codes.
		// 38 = ArrowUp, 40 = ArrowDown
		bool up = key == 38;
		bool down = key == 40;
		if ( !up && !down ) return;

		var current = _textEntry.Text ?? "";

		// Only start history nav from an empty input (unless already navigating).
		if ( _historyIndex == -1 && !string.IsNullOrWhiteSpace( current ) )
			return;

		if ( _historyIndex == -1 )
			_historyDraft = current;

		if ( up )
		{
			if ( _historyIndex < _sentHistory.Count - 1 )
				_historyIndex++;
		}
		else
		{
			if ( _historyIndex >= 0 )
				_historyIndex--;
		}

		string nextText;
		if ( _historyIndex < 0 )
		{
			nextText = _historyDraft;
		}
		else
		{
			int offsetFromEnd = _historyIndex + 1; // 1 = most recent
			nextText = _sentHistory[^offsetFromEnd];
		}

		_textEntry.Text = nextText;
		_inputText = nextText;
		_wantFocusEntry = true;
	}

	void ApplyLayoutPosition()
	{
		if ( Panel == null ) return;
		VeggaHudLayoutApply.Apply( Panel, ChatKey, VeggaHudLayoutState.GetDefaultPosition( ChatKey ), 1f );
	}

	bool ShouldShowBadge( ChatMessage msg, out string badgeText )
	{
		badgeText = null;
		if ( msg == null ) return false;

		if ( msg.Type == ChatMessageType.System ) { badgeText = "SYS"; return true; }
		if ( msg.Type == ChatMessageType.Admin ) { badgeText = "ADM"; return true; }
		if ( msg.Type == ChatMessageType.Private || msg.IsPrivate ) { badgeText = "PM"; return true; }
		if ( msg.Type == ChatMessageType.Error ) { badgeText = "ERR"; return true; }

		return false;
	}

	void UpdateSuggestions()
	{
		_suggestions.Clear();
		_selectedSuggestionIndex = 0;

		var text = _inputText ?? string.Empty;
		text = text.TrimStart();
		if ( text.Length == 0 ) return;

		// Commands only
		if ( text.StartsWith( "/" ) )
		{
			BuildSlashSuggestions( text );
			return;
		}
		if ( text.StartsWith( "!" ) )
		{
			BuildBangSuggestions( text );
			return;
		}
	}

	void BuildSlashSuggestions( string text )
	{
		// /<cmd> ...
		var after = text.Substring( 1 );
		var hasSpace = after.Contains( ' ' );
		var parts = after.Split( ' ', StringSplitOptions.RemoveEmptyEntries );
		var cmdPart = parts.Length > 0 ? parts[0] : "";

		// If we're still typing the command name
		if ( !hasSpace )
		{
			foreach ( var cmd in VeggaChatManager.GetRegisteredCommands().OrderBy( c => c.Name ) )
			{
				if ( string.IsNullOrEmpty( cmdPart ) || cmd.Name.StartsWith( cmdPart, System.StringComparison.OrdinalIgnoreCase ) )
				{
					_suggestions.Add( new ChatSuggestion( "cmd", $"/{cmd.Name}", cmd.Description, $"/{cmd.Name} " ) );
				}
			}
			if ( "hex".StartsWith( cmdPart, System.StringComparison.OrdinalIgnoreCase ) )
			{
				_suggestions.Add( new ChatSuggestion( "admin", "/hex", "Admin commands", "/hex " ) );
			}
			return;
		}

		// /hex <admincmd> ...
		if ( parts.Length > 0 && string.Equals( parts[0], "hex", System.StringComparison.OrdinalIgnoreCase ) )
		{
			BuildAdminSuggestions( prefix: "/hex", restParts: parts.Skip( 1 ).ToArray(), rawText: text );
			return;
		}
	}

	void BuildBangSuggestions( string text )
	{
		// We require !hex
		if ( text == "!" || "!hex".StartsWith( text, System.StringComparison.OrdinalIgnoreCase ) )
		{
			_suggestions.Add( new ChatSuggestion( "admin", "!hex", "Admin commands", "!hex " ) );
			return;
		}

		if ( text.StartsWith( "!hex", System.StringComparison.OrdinalIgnoreCase ) )
		{
			var after = text.Substring( 4 ).TrimStart();
			var parts = after.Split( ' ', StringSplitOptions.RemoveEmptyEntries );
			BuildAdminSuggestions( prefix: "!hex", restParts: parts, rawText: text );
		}
	}

	void BuildAdminSuggestions( string prefix, string[] restParts, string rawText )
	{
		// restParts = [adminCmd, arg1, arg2...]
		var needsCmd = restParts.Length == 0 && !rawText.EndsWith( " " );
		var cmdTyped = restParts.Length > 0 ? restParts[0] : "";
		var hasCmdSpace = rawText.TrimEnd().Contains( ' ' ) && rawText.TrimEnd().Length > prefix.Length;

		if ( restParts.Length == 0 || (restParts.Length == 1 && !rawText.EndsWith( " " )) )
		{
			foreach ( var cmd in VeggaAdminManager.GetCommands().OrderBy( c => c.Name ) )
			{
				if ( string.IsNullOrEmpty( cmdTyped ) || cmd.Name.StartsWith( cmdTyped, System.StringComparison.OrdinalIgnoreCase ) )
				{
					_suggestions.Add( new ChatSuggestion( "hex", cmd.Name, cmd.Description, $"{prefix} {cmd.Name} " ) );
				}
			}
			return;
		}

		// args suggestions (players then common amounts)
		var args = restParts.Skip( 1 ).ToArray();
		if ( args.Length <= 1 )
		{
			var typed = args.Length == 1 ? args[0] : "";
			foreach ( var p in GetPlayerNames() )
			{
				if ( string.IsNullOrEmpty( typed ) || p.StartsWith( typed, System.StringComparison.OrdinalIgnoreCase ) || p.Contains( typed, System.StringComparison.OrdinalIgnoreCase ) )
				{
					_suggestions.Add( new ChatSuggestion( "player", p, "", $"{prefix} {restParts[0]} {p} " ) );
				}
			}
			return;
		}

		// amount suggestions
		if ( args.Length >= 2 )
		{
			foreach ( var amt in new[] { "100", "500", "1000", "2500", "5000", "10000" } )
			{
				_suggestions.Add( new ChatSuggestion( "amt", amt, "", $"{prefix} {restParts[0]} {args[0]} {amt}" ) );
			}
		}
	}

	IEnumerable<string> GetPlayerNames()
	{
		var scene = Game.ActiveScene;
		if ( scene is null ) return Array.Empty<string>();
		return scene.GetAllComponents<PlayerVeggaStats>()
			.Select( s => s?.Network?.Owner?.DisplayName )
			.Where( n => !string.IsNullOrWhiteSpace( n ) )
			.Distinct()
			.OrderBy( n => n )
			.ToList();
	}

	void AcceptSuggestion( int index )
	{
		if ( index < 0 || index >= _suggestions.Count ) return;
		var s = _suggestions[index];
		if ( _textEntry == null ) return;

		_textEntry.Text = s.Insert;
		_inputText = s.Insert;
		_suggestions.Clear();
		_selectedSuggestionIndex = 0;
		_wantFocusEntry = true;
	}

	record ChatSuggestion( string Kind, string Main, string Desc, string Insert );

	void OnMessageReceived( ChatMessage msg )
	{
		_messages.Add( msg );
		_isOpen = true;
		_lastMessageTime = Time.Now;

		// Trim old messages
		while ( _messages.Count > 50 )
		{
			_messages.RemoveAt( 0 );
		}

		// Scroll to bottom unless the user is reading history (scrolled up while focused/hovering)
		if ( !(_isFocused || _isHoveringMessages) || !_lockToHistoryScroll )
		{
			_pendingScrollToBottom = true;
		}
	}

	void OnMessagesChanged( ChatMessage msg )
	{
		_messagesVersion++;
	}

	void ScrollToBottom()
	{
		// Scroll messages panel to bottom
		if ( _messagesPanel == null ) return;
		try
		{
			_messagesPanel.ScrollOffset = new Vector2( 0, 99999 );
		}
		catch ( Exception )
		{
			_messagesPanel = null;
		}
	}

	IEnumerable<ChatMessage> GetVisibleMessages()
	{
		if ( _chatManager == null ) return _messages.TakeLast( 20 );

		// If focused, show a lot more so scroll-back works
		if ( _isFocused )
		{
			var cap = _chatManager.MaxMessages > 0 ? _chatManager.MaxMessages : 100;
			var take = Math.Max( FocusedTakeInitial, Math.Min( cap, _focusedTake ) );
			return _chatManager.Messages.TakeLast( take ).ToList();
		}

		// Hovering (not focused): allow scrollback without opening chat input.
		if ( _isHoveringMessages )
		{
			var cap = _chatManager.MaxMessages > 0 ? _chatManager.MaxMessages : 100;
			var take = Math.Max( HoverTakeInitial, Math.Min( cap, _hoverTake ) );
			return _chatManager.Messages.TakeLast( take ).ToList();
		}

		// Viewer mode: keep render cost small but show enough context.
		return _chatManager.Messages.TakeLast( 10 ).ToList();
	}

	string GetMessageClass( ChatMessage msg )
	{
		return msg.Type switch
		{
			ChatMessageType.Normal => "normal",
			ChatMessageType.System => "system",
			ChatMessageType.Help => "help",
			ChatMessageType.Admin => "admin",
			ChatMessageType.Private => "private",
			ChatMessageType.Action => "action",
			ChatMessageType.Error => "error",
			_ => "normal"
		};
	}

	protected override int BuildHash()
	{
		var hash = new HashCode();
		hash.Add( _isOpen );
		hash.Add( _isFocused );
		hash.Add( _isHoveringMessages );
		hash.Add( _inputText );
		hash.Add( _chatManager?.Messages?.Count ?? 0 );
		hash.Add( _focusedTake );
		hash.Add( _hoverTake );
		hash.Add( _lockToHistoryScroll );
		hash.Add( _messagesVersion );
		hash.Add( _suggestions.Count );
		hash.Add( _selectedSuggestionIndex );
		return hash.ToHashCode();
	}

	int GetReactionCount( ChatMessage msg, string reactionKey )
	{
		if ( msg?.Reactions == null ) return 0;
		return msg.Reactions.TryGetValue( reactionKey, out var count ) ? count : 0;
	}

	void SendReaction( ChatMessage msg, string reactionKey )
	{
		if ( msg == null ) return;
		try
		{
			_chatManager?.AddReaction( msg.MessageId, reactionKey );
		}
		catch ( Exception ex )
		{
			_chatManager?.AddLocalMessage( $"Failed to react: {ex.Message}", ChatMessageType.Error );
			Log.Warning( ex, "[VeggaChat] AddReaction failed" );
		}
	}

	bool TryGetPinned( out ChatMessage pinned, out int likeCount )
	{
		pinned = null;
		likeCount = 0;
		if ( _chatManager == null ) return false;

		var id = _chatManager.PinnedMessageId;
		if ( id == Guid.Empty ) return false;

		float now = Time.Now;
		if ( _chatManager.PinnedUntilTime > 0f && now >= _chatManager.PinnedUntilTime )
			return false;
		if ( _chatManager.PinnedResetTime > 0f && now >= _chatManager.PinnedResetTime )
			return false;

		pinned = _chatManager.Messages.FirstOrDefault( m => m.MessageId == id );
		if ( pinned == null ) return false;

		likeCount = GetReactionCount( pinned, "like" );
		return likeCount >= 3;
	}
}

@using Sandbox
@using Sandbox.UI
@using System
@namespace Sandbox.UI
@inherits PanelComponent
@attribute [StyleSheet( "/ui/hud/veggahudlayoutoverlay.razor.scss" )]

<root>
	@if ( IsLayoutActive )
	{
		<div class="hud-layout-editor">
			@* Header *@
			<div class="layout-header">
				<h2 class="layout-title">Layout Editor</h2>
				<p class="layout-subtitle">Changes auto-save instantly ・ ESC exits</p>
			</div>

			@* Element Selector *@
			<div class="element-selector">
				<div class="element-title-row">
					<h3 class="section-title">Select Element ・ ➤</h3>
					@if ( SelectedElement != null )
					{
						<div class="editing-indicator">@GetElementName(SelectedElement)</div>
					}
				</div>
				<div class="element-buttons">
					@foreach ( var key in GetElementKeys() )
					{
						<button class="element-btn @(SelectedElement == key ? "selected" : "")" 
								onclick="@(() => SelectElement(key))">
							@GetElementName(key)
						</button>
					}
				</div>
			</div>

			

			@* Position Presets *@
			@if ( SelectedElement != null )
			{
				<div class="position-presets">
					<h3 class="section-title">Position Presets</h3>
					
					@* 3x3 Grid of position presets - using rows for s&box compatibility *@
					<div class="preset-flex">
						<div class="preset-row">
							<button class="preset-btn @(GetCurrentPreset() == 0 ? "active" : "")" onclick="@(() => SetPreset(0))">Top Left</button>
							<button class="preset-btn @(GetCurrentPreset() == 1 ? "active" : "")" onclick="@(() => SetPreset(1))">Top</button>
							<button class="preset-btn @(GetCurrentPreset() == 2 ? "active" : "")" onclick="@(() => SetPreset(2))">Top Right</button>
						</div>
						<div class="preset-row">
							<button class="preset-btn @(GetCurrentPreset() == 3 ? "active" : "")" onclick="@(() => SetPreset(3))">Left</button>
							<button class="preset-btn @(GetCurrentPreset() == 4 ? "active" : "")" onclick="@(() => SetPreset(4))">Center</button>
							<button class="preset-btn @(GetCurrentPreset() == 5 ? "active" : "")" onclick="@(() => SetPreset(5))">Right</button>
						</div>
						<div class="preset-row">
							<button class="preset-btn @(GetCurrentPreset() == 6 ? "active" : "")" onclick="@(() => SetPreset(6))">Bottom Left</button>
							<button class="preset-btn @(GetCurrentPreset() == 7 ? "active" : "")" onclick="@(() => SetPreset(7))">Bottom</button>
							<button class="preset-btn @(GetCurrentPreset() == 8 ? "active" : "")" onclick="@(() => SetPreset(8))">Bottom Right</button>
						</div>
					</div>

					<div class="fine-tune-controls">
						@* Fine-tune nudge controls *@
						<div class="nudge-controls">
							<h4 class="nudge-title">Fine Tune (pixels)</h4>
							<div class="nudge-presets">
								@foreach ( var preset in _nudgePresetSteps )
								{
									<button class="nudge-preset-btn @((Math.Abs(_nudgePixels - preset) < 0.01f) ? "active" : "")"
											onclick="@(() => SetNudgePixels(preset))">@FormatNudgeLabel(preset)</button>
								}
							</div>
							<div class="nudge-custom-row">
								<textentry class="nudge-entry" @ref="_nudgeEntry" onsubmit="@ApplyCustomNudge" />
								<button class="nudge-apply-btn" onclick="@ApplyCustomNudge">Set</button>
							</div>
							<div class="nudge-flex">
								<div class="nudge-row">
									<div class="nudge-spacer"></div>
									<button class="nudge-btn" onclick="@(() => Nudge(0, -_nudgePixels))">UP</button>
									<div class="nudge-spacer"></div>
								</div>
								<div class="nudge-row">
									<button class="nudge-btn" onclick="@(() => Nudge(-_nudgePixels, 0))">L</button>
									<div class="nudge-info">@FormatNudgeLabel(_nudgePixels)</div>
									<button class="nudge-btn" onclick="@(() => Nudge(_nudgePixels, 0))">R</button>
								</div>
								<div class="nudge-row">
									<div class="nudge-spacer"></div>
									<button class="nudge-btn" onclick="@(() => Nudge(0, _nudgePixels))">DN</button>
									<div class="nudge-spacer"></div>
								</div>
							</div>
						</div>

						@* Scale control *@
						<div class="scale-controls">
							<h4 class="scale-title">Scale: @(GetCurrentScale().ToString("P0"))</h4>
							<div class="scale-buttons">
								<button class="scale-btn" onclick="@(() => SetScale(0.75f))">75%</button>
								<button class="scale-btn" onclick="@(() => SetScale(1.0f))">100%</button>
								<button class="scale-btn" onclick="@(() => SetScale(1.25f))">125%</button>
								<button class="scale-btn" onclick="@(() => SetScale(1.5f))">150%</button>
							</div>
						</div>
					</div>
				</div>
			}

			@* Actions *@
			<div class="layout-actions">
				<button class="action-btn reset" onclick="@ResetLayout">Reset All</button>
				<button class="action-btn reset-selected" onclick="@ResetSelected" disabled="@(SelectedElement == null)">Reset Selected</button>
				<button class="action-btn reset-selected" onclick="@ToggleDebug">Debug: @(_debug ? "On" : "Off")</button>
				<button class="action-btn done" onclick="@ExitLayout">Save &amp; Exit</button>
			</div>
		</div>

		@* Visual guides showing current positions *@
		<div class="position-guides">
			@foreach ( var key in GetElementKeys() )
			{
				var pos = GetGuidePosition(key);
				<div class="guide-marker @(SelectedElement == key ? "selected" : "")" 
					 style="left: @(pos.x * 100)%; top: @(pos.y * 100)%;">
					<span class="guide-label">@GetElementShortName(key)</span>
				</div>
			}

			@if ( _debug && SelectedElement != null )
			{
				if ( TryGetSelectedDebugRect( out var left, out var top, out var width, out var height, out var label ) )
				{
					<div class="debug-rect" style="left: @left%; top: @top%; width: @width%; height: @height%;"></div>
					<div class="debug-text" style="left: @left%; top: @top%;">@label</div>
				}
			}
		</div>
	}
</root>

@code
{
	bool _lastActive;

	// Instance wrappers
	bool IsLayoutActive => VeggaHudLayoutState.IsActive;
	string SelectedElement => VeggaHudLayoutState.SelectedElement;
	void SetLayoutActive( bool active ) => VeggaHudLayoutState.SetActive( active );
	void ResetAllPositions() => VeggaHudLayoutState.ResetAll();

	System.Collections.Generic.List<string> GetElementKeys() => VeggaHudLayoutState.GetAllElementKeys();
	string GetElementName( string key ) => VeggaHudLayoutState.GetElementName( key );

	readonly float[] _nudgePresetSteps = new[] { 0.5f, 1f, 2f, 4f, 8f, 16f, 32f, 64f, 128f };
	float _nudgePixels { get; set; } = 4f;
	TextEntry _nudgeEntry;

	bool _debug;

	string FormatNudgeLabel( float px )
	{
		// Keep it compact (eg. 0.5px, 12px)
		return $"{px:0.##}px";
	}

	void SetNudgePixels( float px )
	{
		_nudgePixels = Math.Max( 0.5f, Math.Min( 500f, px ) );
		if ( _nudgeEntry != null )		// reflect current value
		{
			_nudgeEntry.Text = _nudgePixels.ToString( "0.##" );
		}
	}

	void ApplyCustomNudge()
	{
		if ( _nudgeEntry == null ) return;
		var raw = (_nudgeEntry.Text ?? string.Empty).Trim();
		if ( string.IsNullOrWhiteSpace( raw ) ) return;

		// Allow entering "12", "12px", "0.5" etc.
		raw = raw.Replace( "px", "", System.StringComparison.OrdinalIgnoreCase ).Trim();
		if ( float.TryParse( raw, out var value ) )
		{
			SetNudgePixels( value );
		}
	}

	string GetElementShortName( string key )
	{
		return key switch
		{
			VeggaHudLayoutState.KeyPlayerHud => "HP",
			VeggaHudLayoutState.KeyXpBar => "XP",
			VeggaHudLayoutState.KeyChat => "Chat",
			VeggaHudLayoutState.KeyMinimap => "Map",
			VeggaHudLayoutState.KeyInventory => "Inv",
			_ => key.Substring( 0, 2 ).ToUpper()
		};
	}

	Vector2 GetElementPosition( string key )
	{
		return VeggaHudLayoutState.GetPosition( key, new Vector2( 0.5f, 0.5f ) );
	}

	Vector2 GetGuidePosition( string key )
	{
		if ( VeggaHudLayoutApply.TryGetLastApplied( key, out var info ) )
			return info.PositionN;
		return GetElementPosition( key );
	}

	void ToggleDebug()
	{
		_debug = !_debug;
		StateHasChanged();
	}

	static Vector2 AnchorOffsetPx( VeggaHudLayoutState.HudAnchor anchor, Vector2 sizePx )
	{
		return anchor switch
		{
			VeggaHudLayoutState.HudAnchor.TopLeft => new Vector2( 0, 0 ),
			VeggaHudLayoutState.HudAnchor.TopCenter => new Vector2( -sizePx.x * 0.5f, 0 ),
			VeggaHudLayoutState.HudAnchor.TopRight => new Vector2( -sizePx.x, 0 ),
			VeggaHudLayoutState.HudAnchor.MiddleLeft => new Vector2( 0, -sizePx.y * 0.5f ),
			VeggaHudLayoutState.HudAnchor.MiddleCenter => new Vector2( -sizePx.x * 0.5f, -sizePx.y * 0.5f ),
			VeggaHudLayoutState.HudAnchor.MiddleRight => new Vector2( -sizePx.x, -sizePx.y * 0.5f ),
			VeggaHudLayoutState.HudAnchor.BottomLeft => new Vector2( 0, -sizePx.y ),
			VeggaHudLayoutState.HudAnchor.BottomCenter => new Vector2( -sizePx.x * 0.5f, -sizePx.y ),
			VeggaHudLayoutState.HudAnchor.BottomRight => new Vector2( -sizePx.x, -sizePx.y ),
			_ => new Vector2( -sizePx.x * 0.5f, -sizePx.y * 0.5f )
		};
	}

	bool TryGetSelectedDebugRect( out float leftPct, out float topPct, out float wPct, out float hPct, out string label )
	{
		leftPct = topPct = wPct = hPct = 0f;
		label = string.Empty;

		var key = SelectedElement;
		if ( string.IsNullOrWhiteSpace( key ) )
			return false;

		if ( !VeggaHudLayoutApply.TryGetLastApplied( key, out var info ) )
			return false;
		if ( !info.HasValidSize )
			return false;

		var screen = info.ScreenPx;
		if ( screen.x <= 1f || screen.y <= 1f )
			return false;

		var anchorPx = new Vector2( info.PositionN.x * screen.x, info.PositionN.y * screen.y );
		var topLeftPx = anchorPx + AnchorOffsetPx( info.Anchor, info.SizePxScaled );

		leftPct = (topLeftPx.x / screen.x) * 100f;
		topPct = (topLeftPx.y / screen.y) * 100f;
		wPct = (info.SizePxScaled.x / screen.x) * 100f;
		hPct = (info.SizePxScaled.y / screen.y) * 100f;

		label = $"{key}  anchor={info.Anchor}  pos={info.PositionN:0.###}  sizePx={info.SizePxScaled:0}  safe={info.SafeMinN:0.##}-{info.SafeMaxN:0.##}";
		return true;
	}

	int GetCurrentPreset()
	{
		if ( SelectedElement == null ) return -1;
		return (int)VeggaHudLayoutState.GetPreset( SelectedElement );
	}

	float GetCurrentScale()
	{
		if ( SelectedElement == null ) return 1f;
		return VeggaHudLayoutState.GetScale( SelectedElement, 1f );
	}

	protected override void OnUpdate()
	{
		if ( _nudgeEntry != null )
		{
			_nudgeEntry.Placeholder = "px (max 500)";
		}

		bool active = IsLayoutActive;
		Panel.Style.PointerEvents = active ? PointerEvents.All : PointerEvents.None;

		if ( active && Input.EscapePressed )
		{
			Input.EscapePressed = false;
			ExitLayout();
			return;
		}

		if ( active != _lastActive )
		{
			_lastActive = active;
			Log.Info( $"[VeggaHudLayoutOverlay] Active = {_lastActive}" );
		}
	}

	void SelectElement( string key )
	{
		VeggaHudLayoutState.SelectedElement = key;
		Log.Info( $"[HUD Layout] Selected: {key}" );
	}

	void SetPreset( int presetIndex )
	{
		if ( SelectedElement == null ) return;
		VeggaHudLayoutState.SetPreset( SelectedElement, (VeggaHudLayoutState.ScreenPosition)presetIndex );
	}

	void Nudge( float x, float y )
	{
		if ( SelectedElement == null ) return;
		VeggaHudLayoutState.NudgePosition( SelectedElement, new Vector2( x, y ) );
	}

	void SetScale( float scale )
	{
		if ( SelectedElement == null ) return;
		VeggaHudLayoutState.SetScale( SelectedElement, scale );
	}

	void ResetLayout()
	{
		// "Reset All" should fully clean saved state (including any historical calibration data)
		// and revert to defaults.
		VeggaHudLayoutState.WipeAllSavedLayoutData();
		Log.Info( "[HUD Layout] Reset all (wiped saved layout)" );
	}

	void ResetSelected()
	{
		if ( SelectedElement == null ) return;
		var pos = VeggaHudLayoutState.GetDefaultPosition( SelectedElement );
		VeggaHudLayoutState.SetPosition( SelectedElement, pos );
		VeggaHudLayoutState.SetScale( SelectedElement, 1f );
		Log.Info( $"[HUD Layout] Reset selected {SelectedElement} -> default" );
	}

	void ExitLayout()
	{
		SetLayoutActive( false );
		Log.Info( "[HUD Layout] Exited layout mode" );
	}
}

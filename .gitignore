
# This file describes files and paths that should not be tracked by Git version control
# https://git-scm.com/docs/gitignore

# Auto-generated code editor files
.vs/*
.vscode/*
*.csproj
obj
bin
Properties/*
code/obj/*
code/Properties/*
Thumbs.db
.DS_Store
*.log

# Local env / temp
.env
.env.*
tmp/
temp/
.cache/

# Auto-generated asset related files
.sbox/*
*.generated.*
*.*_c
!*.shader_c
*.los
*.vpk
*launchSettings.json
*.sln
*.slnx

*idea

# Exported / standalone games
Exports/

# Common package / tooling outputs inside the workspace
node_modules/
dist/
coverage/
